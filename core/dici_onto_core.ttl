                        rdfs:subClassOf dici_onto:ComponentAttribute ;
                        rdfs:label "Flow Attribute" ;
                        rdfs:comment "Typing marker grouping attributes that apply to a Flow; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


