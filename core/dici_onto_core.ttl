dici_onto:MaterialConverter rdf:type owl:Class ;
                            rdfs:subClassOf dici_onto:Converter ;
                            rdfs:label "Material Converter" ;
                            rdfs:comment "Converter transforming material inputs into different material outputs"@en ;
                            skos:example "Waste incinerator, biogas digester, recycling plant"@en .


