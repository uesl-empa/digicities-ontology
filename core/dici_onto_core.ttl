@prefix : <https://digicities.info/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dici_onto: <https://digicities.info/ontology#> .
@base <https://digicities.info/ontology#> .

<https://digicities.info/ontology> rdf:type owl:Ontology ;
    rdfs:label "Digicities ontology"@en ;
    rdfs:comment "Open OWL/RDF ontology for describing city-scale energy systems."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source <https://digicities.info/ontology> .

#################################################################
#    Annotation properties
#################################################################

###  https://digicities.info/ontology#Author
dici_onto:Author rdf:type owl:AnnotationProperty .


###  https://digicities.info/ontology#Collaborator
dici_onto:Collaborator rdf:type owl:AnnotationProperty .


###  https://digicities.info/ontology#Institution
dici_onto:Institution rdf:type owl:AnnotationProperty .


###  https://digicities.info/ontology#Synonymous
dici_onto:Synonymous rdf:type owl:AnnotationProperty .


###  https://digicities.info/ontology#abbreviation
dici_onto:abbreviation rdf:type owl:AnnotationProperty .


###  https://digicities.info/ontology#definition
dici_onto:definition rdf:type owl:AnnotationProperty .


###  https://digicities.info/ontology#hasDefaultUnit
dici_onto:hasDefaultUnit rdf:type owl:AnnotationProperty ;
                         rdfs:range qudt:Unit ;
                         rdfs:domain dici_onto:Attribute .


###  https://digicities.info/ontology#hasQuantityKind
dici_onto:hasQuantityKind rdf:type owl:AnnotationProperty ;
                          rdfs:range qudt:QuantityKind ;
                          rdfs:domain dici_onto:Attribute .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://qudt.org/schema/qudt/unit
qudt:unit rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf dici_onto:hasUnit ;
          rdfs:domain dici_onto:Attribute ;
          rdfs:range qudt:Unit .


###  https://digicities.info/ontology#actuates
dici_onto:actuates rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf dici_onto:controls ;
                   rdfs:domain dici_onto:Actuator ;
                   rdfs:range dici_onto:Component ;
                   rdfs:comment "Actuator physically controls a component"@en ;
                   rdfs:label "actuates" .


###  https://digicities.info/ontology#assumptionObjectProperty
dici_onto:assumptionObjectProperty rdf:type owl:ObjectProperty .


###  https://digicities.info/ontology#carriesEnergyCarrier
dici_onto:carriesEnergyCarrier rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf dici_onto:carriesResource ;
                               rdfs:domain dici_onto:EnergyCarrierFlow ;
                               rdfs:range dici_onto:EnergyCarrier ;
                               rdfs:label "carries energy carrier" .


###  https://digicities.info/ontology#carriesResource
dici_onto:carriesResource rdf:type owl:ObjectProperty ;
                          rdfs:domain dici_onto:Flow ;
                          rdfs:range dici_onto:Resource ;
                          rdfs:comment "The resource (energy carrier or material) being transported by the flow"@en ;
                          rdfs:label "carries resource" .


###  https://digicities.info/ontology#contains
dici_onto:contains rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf dici_onto:linksComponent .


###  https://digicities.info/ontology#controls
dici_onto:controls rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf dici_onto:linksComponent ;
                   rdfs:domain dici_onto:Device ;
                   rdfs:range dici_onto:Component ;
                   rdfs:comment "Device controls another component"@en ;
                   rdfs:label "controls" .


###  https://digicities.info/ontology#currency
dici_onto:currency rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdfs:range qudt:CurrencyUnit ;
                   rdfs:label "currency" .


###  https://digicities.info/ontology#derivedFrom
dici_onto:derivedFrom rdf:type owl:ObjectProperty ;
                      rdfs:domain dici_onto:Scenario ;
                      rdfs:range dici_onto:Scenario .


###  https://digicities.info/ontology#fedBy
dici_onto:fedBy rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf dici_onto:linksComponent ;
                owl:inverseOf dici_onto:feeds ;
                rdfs:domain dici_onto:Component ;
                rdfs:range dici_onto:Component .


###  https://digicities.info/ontology#feeds
dici_onto:feeds rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf dici_onto:linksComponent .


###  https://digicities.info/ontology#flowsThrough
dici_onto:flowsThrough rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf dici_onto:linksComponent ;
                       rdfs:domain dici_onto:Flow ;
                       rdfs:range dici_onto:Location ;
                       rdfs:comment "Locations traversed by a flow"@en ;
                       rdfs:label "flows through" .


###  https://digicities.info/ontology#hasActorAttribute
dici_onto:hasActorAttribute rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf dici_onto:hasComponentAttribute ;
                            rdfs:domain dici_onto:Actor ;
                            rdfs:range dici_onto:ActorAttribute ;
                            rdfs:label "has actor attribute" .


###  https://digicities.info/ontology#hasActuatorAttribute
dici_onto:hasActuatorAttribute rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf dici_onto:hasDeviceAttribute ;
                               rdfs:domain dici_onto:Actuator ;
                               rdfs:range dici_onto:ActuatorAttribute ;
                               rdfs:label "has actuator attribute" .


###  https://digicities.info/ontology#hasAttribute
dici_onto:hasAttribute rdf:type owl:ObjectProperty ;
                       rdfs:domain dici_onto:Component ;
                       rdfs:range dici_onto:Attribute ;
                       rdfs:label "has Attribute" .


###  https://digicities.info/ontology#hasColdAttribute
dici_onto:hasColdAttribute rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf dici_onto:hasThermalEnergyAttribute ;
                           rdfs:domain dici_onto:ColdCarrier .


###  https://digicities.info/ontology#hasColdCarrierAttribute
dici_onto:hasColdCarrierAttribute rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf dici_onto:hasThermalEnergyCarrierAttribute ;
                                  rdfs:domain dici_onto:ColdCarrier ;
                                  rdfs:range dici_onto:ColdCarrierAttribute ;
                                  rdfs:label "has cold carrier attribute" .


###  https://digicities.info/ontology#hasComponentAttribute
dici_onto:hasComponentAttribute rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf dici_onto:hasAttribute .


###  https://digicities.info/ontology#hasControllerAttribute
dici_onto:hasControllerAttribute rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf dici_onto:hasDeviceAttribute ;
                                 rdfs:domain dici_onto:Controller ;
                                 rdfs:range dici_onto:ControllerAttribute ;
                                 rdfs:label "has controller attribute" .


###  https://digicities.info/ontology#hasConversionProcessAttribute
dici_onto:hasConversionProcessAttribute rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf dici_onto:hasProcessAttribute ;
                                        rdfs:domain dici_onto:ConversionProcess ;
                                        rdfs:range dici_onto:ConversionProcessAttribute ;
                                        rdfs:label "has conversion process attribute" .


###  https://digicities.info/ontology#hasConverterAttribute
dici_onto:hasConverterAttribute rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf dici_onto:hasComponentAttribute ;
                                rdfs:domain dici_onto:Converter .


###  https://digicities.info/ontology#hasDataPoints
dici_onto:hasDataPoints rdf:type owl:ObjectProperty ;
                        rdfs:domain dici_onto:CurveAttribute ;
                        rdfs:range rdf:JSON .


###  https://digicities.info/ontology#hasDestination
dici_onto:hasDestination rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf dici_onto:linksComponent ;
                         owl:inverseOf dici_onto:isDestinationOf ;
                         rdfs:domain dici_onto:Flow ;
                         rdfs:range dici_onto:Component ;
                         rdfs:comment "The component to which the flow is directed"@en ;
                         rdfs:label "has destination" .


###  https://digicities.info/ontology#hasDeviceAttribute
dici_onto:hasDeviceAttribute rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf dici_onto:hasComponentAttribute ;
                             rdfs:domain dici_onto:Device ;
                             rdfs:range dici_onto:DeviceAttribute ;
                             rdfs:label "has device attribute" .


###  https://digicities.info/ontology#hasElectricityAttribute
dici_onto:hasElectricityAttribute rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf dici_onto:hasEnergyCarrierAttribute ;
                                  rdfs:domain dici_onto:ElectricityCarrier .


###  https://digicities.info/ontology#hasEnergyCarrierAttribute
dici_onto:hasEnergyCarrierAttribute rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf dici_onto:hasComponentAttribute ;
                                    rdfs:domain dici_onto:EnergyCarrier .


###  https://digicities.info/ontology#hasEnergyCarrierEnergyCostAttribute
dici_onto:hasEnergyCarrierEnergyCostAttribute rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf dici_onto:hasEnergyCarrierAttribute .


###  https://digicities.info/ontology#hasEnergyCarrierFlowAttribute
dici_onto:hasEnergyCarrierFlowAttribute rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf dici_onto:hasFlowAttribute ;
                                        rdfs:domain dici_onto:EnergyCarrierFlow ;
                                        rdfs:range dici_onto:EnergyCarrierFlowAttribute ;
                                        rdfs:label "has energy carrier flow attribute" .


###  https://digicities.info/ontology#hasEnergyConsumerAttribute
dici_onto:hasEnergyConsumerAttribute rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf dici_onto:hasComponentAttribute ;
                                     rdfs:domain dici_onto:EnergyConsumer .


###  https://digicities.info/ontology#hasEnergyConverterAttribute
dici_onto:hasEnergyConverterAttribute rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf dici_onto:hasConverterAttribute ;
                                      rdfs:domain dici_onto:EnergyConverter .


###  https://digicities.info/ontology#hasEnergyGeneratorAttribute
dici_onto:hasEnergyGeneratorAttribute rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf dici_onto:hasComponentAttribute ;
                                      rdfs:domain dici_onto:EnergyGenerator .


###  https://digicities.info/ontology#hasEnergyStorageAttribute
dici_onto:hasEnergyStorageAttribute rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf dici_onto:hasStorageAttribute ;
                                    rdfs:domain dici_onto:EnergyStorage ;
                                    rdfs:range dici_onto:EnergyStorageAttribute ;
                                    rdfs:label "has energy storage attribute" .


###  https://digicities.info/ontology#hasFlowAttribute
dici_onto:hasFlowAttribute rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf dici_onto:hasComponentAttribute ;
                           rdfs:domain dici_onto:Flow ;
                           rdfs:range dici_onto:FlowAttribute ;
                           rdfs:label "has flow attribute" .


###  https://digicities.info/ontology#hasFuelAttribute
dici_onto:hasFuelAttribute rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf dici_onto:hasEnergyCarrierAttribute ;
                           rdfs:domain dici_onto:FuelCarrier .


###  https://digicities.info/ontology#hasFutureTimeSeries
dici_onto:hasFutureTimeSeries rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf dici_onto:hasTimeSeries ;
                              owl:inverseOf dici_onto:isFutureTimeSeriesOf .


###  https://digicities.info/ontology#hasGaseousFuelAttribute
dici_onto:hasGaseousFuelAttribute rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf dici_onto:hasFuelAttribute ;
                                  rdfs:domain dici_onto:GaseousFuelCarrier .


###  https://digicities.info/ontology#hasHeatAttribute
dici_onto:hasHeatAttribute rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf dici_onto:hasThermalEnergyAttribute ;
                           rdfs:domain dici_onto:HeatCarrier .


###  https://digicities.info/ontology#hasHeatCarrierAttribute
dici_onto:hasHeatCarrierAttribute rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf dici_onto:hasThermalEnergyCarrierAttribute ;
                                  rdfs:domain dici_onto:HeatCarrier ;
                                  rdfs:range dici_onto:HeatCarrierAttribute ;
                                  rdfs:label "has heat carrier attribute" .


###  https://digicities.info/ontology#hasHistoricTimeSeries
dici_onto:hasHistoricTimeSeries rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf dici_onto:hasTimeSeries ;
                                owl:inverseOf dici_onto:isHistoricTimeSeriesOf .


###  https://digicities.info/ontology#hasIdentifier
dici_onto:hasIdentifier rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf dici_onto:hasAttribute .


###  https://digicities.info/ontology#hasInformationFlowAttribute
dici_onto:hasInformationFlowAttribute rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf dici_onto:hasFlowAttribute ;
                                      rdfs:domain dici_onto:InformationFlow ;
                                      rdfs:range dici_onto:InformationFlowAttribute ;
                                      rdfs:label "has information flow attribute" .


###  https://digicities.info/ontology#hasInput
dici_onto:hasInput rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf dici_onto:linksComponent .


###  https://digicities.info/ontology#hasInputAttribute
dici_onto:hasInputAttribute rdf:type owl:ObjectProperty ;
                            owl:inverseOf dici_onto:isAttributeOf ;
                            rdfs:domain dici_onto:ServiceRequirement ;
                            rdfs:range dici_onto:Attribute ;
                            rdfs:label "has input attribute" .


###  https://digicities.info/ontology#hasInputEntity
dici_onto:hasInputEntity rdf:type owl:ObjectProperty ;
                         owl:inverseOf dici_onto:isEntityOf ;
                         rdfs:domain dici_onto:ComponentLink ,
                                     dici_onto:ServiceRequirement ;
                         rdfs:range dici_onto:Component ;
                         rdfs:label "has input entity" .


###  https://digicities.info/ontology#hasInputFlow
dici_onto:hasInputFlow rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf dici_onto:linksComponent ;
                       rdfs:domain dici_onto:Component ;
                       rdfs:range dici_onto:Flow ;
                       rdfs:comment "Links a component to its input flows"@en ;
                       rdfs:label "has input flow" .


###  https://digicities.info/ontology#hasJunctionAttribute
dici_onto:hasJunctionAttribute rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf dici_onto:hasComponentAttribute ;
                               rdfs:domain dici_onto:Junction ;
                               rdfs:range dici_onto:JunctionAttribute ;
                               rdfs:label "has junction attribute" .


###  https://digicities.info/ontology#hasLiquidFuelAttribute
dici_onto:hasLiquidFuelAttribute rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf dici_onto:hasFuelAttribute ;
                                 rdfs:domain dici_onto:LiquidFuel ;
                                 rdfs:range dici_onto:LiquidFuelCarrierAttribute ;
                                 rdfs:label "has liquid fuel attribute" .


###  https://digicities.info/ontology#hasLiveTimeSeries
dici_onto:hasLiveTimeSeries rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf dici_onto:hasTimeSeries ;
                            owl:inverseOf dici_onto:isLiveTimeSeriesOf .


###  https://digicities.info/ontology#hasLocation
dici_onto:hasLocation rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf dici_onto:linksComponent ;
                      owl:inverseOf dici_onto:locationOf .


###  https://digicities.info/ontology#hasLocationAttribute
dici_onto:hasLocationAttribute rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf dici_onto:hasComponentAttribute ;
                               rdfs:domain dici_onto:Location ;
                               rdfs:range dici_onto:LocationAttribute ;
                               rdfs:label "has location attribute" .


###  https://digicities.info/ontology#hasMaterialAttribute
dici_onto:hasMaterialAttribute rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf dici_onto:hasComponentAttribute ;
                               rdfs:domain dici_onto:Material .


###  https://digicities.info/ontology#hasMaterialConverterAttribute
dici_onto:hasMaterialConverterAttribute rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf dici_onto:hasConverterAttribute ;
                                        rdfs:domain dici_onto:MaterialConverter .


###  https://digicities.info/ontology#hasMaterialFlowAttribute
dici_onto:hasMaterialFlowAttribute rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf dici_onto:hasFlowAttribute ;
                                   rdfs:domain dici_onto:MaterialFlow ;
                                   rdfs:range dici_onto:MaterialFlowAttribute ;
                                   rdfs:label "has material flow attribute" .


###  https://digicities.info/ontology#hasMaterialStorageAttribute
dici_onto:hasMaterialStorageAttribute rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf dici_onto:hasStorageAttribute ;
                                      rdfs:domain dici_onto:MaterialStorage ;
                                      rdfs:range dici_onto:MaterialStorageAttribute ;
                                      rdfs:label "has material storage attribute" .


###  https://digicities.info/ontology#hasMeterAttribute
dici_onto:hasMeterAttribute rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf dici_onto:hasDeviceAttribute ;
                            rdfs:domain dici_onto:Meter ;
                            rdfs:range dici_onto:MeterAttribute ;
                            rdfs:label "has meter attribute" .


###  https://digicities.info/ontology#hasNetworkAttribute
dici_onto:hasNetworkAttribute rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf dici_onto:hasComponentAttribute ;
                              rdfs:domain dici_onto:Network ;
                              rdfs:range dici_onto:NetworkAttribute ;
                              rdfs:label "has network attribute" .


###  https://digicities.info/ontology#hasNonRenewableAttribute
dici_onto:hasNonRenewableAttribute rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf dici_onto:hasResourceAttribute ;
                                   rdfs:domain dici_onto:NonRenewableResource .


###  https://digicities.info/ontology#hasNonRenewableResourceAttribute
dici_onto:hasNonRenewableResourceAttribute rdf:type owl:ObjectProperty ;
                                           rdfs:subPropertyOf dici_onto:hasResourceAttribute ;
                                           rdfs:domain dici_onto:NonRenewableResource ;
                                           rdfs:range dici_onto:NonRenewableResourceAttribute ;
                                           rdfs:label "has non renewable resource attribute" .


###  https://digicities.info/ontology#hasOutputFlow
dici_onto:hasOutputFlow rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf dici_onto:linksComponent ;
                        rdfs:domain dici_onto:Component ;
                        rdfs:range dici_onto:Flow ;
                        rdfs:comment "Links a component to its output flows"@en ;
                        rdfs:label "has output flow" .


###  https://digicities.info/ontology#hasPart
dici_onto:hasPart rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf dici_onto:linksComponent ;
                  owl:inverseOf dici_onto:partOf .


###  https://digicities.info/ontology#hasProcessAttribute
dici_onto:hasProcessAttribute rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf dici_onto:hasComponentAttribute ;
                              rdfs:domain dici_onto:Process ;
                              rdfs:range dici_onto:ProcessAttribute ;
                              rdfs:label "has process attribute" .


###  https://digicities.info/ontology#hasRenewableAttribute
dici_onto:hasRenewableAttribute rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf dici_onto:hasResourceAttribute ;
                                rdfs:domain dici_onto:RenewableResource .


###  https://digicities.info/ontology#hasRenewableResourceAttribute
dici_onto:hasRenewableResourceAttribute rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf dici_onto:hasResourceAttribute ;
                                        rdfs:domain dici_onto:RenewableResource ;
                                        rdfs:range dici_onto:RenewableResourceAttribute ;
                                        rdfs:label "has renewable resource attribute" .


###  https://digicities.info/ontology#hasResourceAttribute
dici_onto:hasResourceAttribute rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf dici_onto:hasComponentAttribute ;
                               rdfs:domain dici_onto:Resource .


###  https://digicities.info/ontology#hasSensorAttribute
dici_onto:hasSensorAttribute rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf dici_onto:hasDeviceAttribute ;
                             rdfs:domain dici_onto:Sensor ;
                             rdfs:range dici_onto:SensorAttribute ;
                             rdfs:label "has sensor attribute" .


###  https://digicities.info/ontology#hasSolarAttribute
dici_onto:hasSolarAttribute rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf dici_onto:hasRenewableAttribute ;
                            rdfs:domain dici_onto:SolarResource .


###  https://digicities.info/ontology#hasSolidFuelAttribute
dici_onto:hasSolidFuelAttribute rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf dici_onto:hasFuelAttribute ;
                                rdfs:domain dici_onto:SolidFuel .


###  https://digicities.info/ontology#hasSource
dici_onto:hasSource rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf dici_onto:linksComponent ;
                    owl:inverseOf dici_onto:isSourceOf ;
                    rdfs:domain dici_onto:Flow ;
                    rdfs:range dici_onto:Component ;
                    rdfs:comment "The component from which the flow originates"@en ;
                    rdfs:label "has source" .


###  https://digicities.info/ontology#hasStorageAttribute
dici_onto:hasStorageAttribute rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf dici_onto:hasComponentAttribute ;
                              rdfs:domain dici_onto:Storage ;
                              rdfs:range dici_onto:StorageAttribute ;
                              rdfs:label "has storage attribute" .


###  https://digicities.info/ontology#hasStorageProcessAttribute
dici_onto:hasStorageProcessAttribute rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf dici_onto:hasProcessAttribute ;
                                     rdfs:domain dici_onto:StorageProcess ;
                                     rdfs:range dici_onto:StorageProcessAttribute ;
                                     rdfs:label "has storage process attribute" .


###  https://digicities.info/ontology#hasSwitchAttribute
dici_onto:hasSwitchAttribute rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf dici_onto:hasDeviceAttribute ;
                             rdfs:domain dici_onto:Switch ;
                             rdfs:range dici_onto:SwitchAttribute ;
                             rdfs:label "has switch attribute" .


###  https://digicities.info/ontology#hasTemporalPrecision
dici_onto:hasTemporalPrecision rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf dici_onto:hasUnit .


###  https://digicities.info/ontology#hasThermalEnergyAttribute
dici_onto:hasThermalEnergyAttribute rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf dici_onto:hasEnergyCarrierAttribute ;
                                    rdfs:domain dici_onto:ThermalEnergyCarrier .


###  https://digicities.info/ontology#hasThermalEnergyCarrierAttribute
dici_onto:hasThermalEnergyCarrierAttribute rdf:type owl:ObjectProperty ;
                                           rdfs:subPropertyOf dici_onto:hasEnergyCarrierAttribute ;
                                           rdfs:domain dici_onto:ThermalEnergyCarrier ;
                                           rdfs:range dici_onto:ThermalEnergyCarrierAttribute ;
                                           rdfs:label "has thermal energy carrier attribute" .


###  https://digicities.info/ontology#hasTimeSeries
dici_onto:hasTimeSeries rdf:type owl:ObjectProperty ;
                        owl:inverseOf dici_onto:isTimeSeriesOf ;
                        rdfs:domain dici_onto:DynamicAttribute ;
                        rdfs:range dici_onto:TimeSeries ;
                        rdfs:comment "Links a dynamic attribute to its associated time series data"@en ;
                        rdfs:label "has time series" .


###  https://digicities.info/ontology#hasTransportProcessAttribute
dici_onto:hasTransportProcessAttribute rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf dici_onto:hasProcessAttribute ;
                                       rdfs:domain dici_onto:TransportProcess ;
                                       rdfs:range dici_onto:TransportProcessAttribute ;
                                       rdfs:label "has transport process attribute" .


###  https://digicities.info/ontology#hasTurbineAttribute
dici_onto:hasTurbineAttribute rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf dici_onto:hasEnergyConverterAttribute ;
                              rdfs:domain dici_onto:Turbine ;
                              rdfs:range dici_onto:TurbineAttribute ;
                              rdfs:label "has turbine attribute" .


###  https://digicities.info/ontology#hasUnit
dici_onto:hasUnit rdf:type owl:ObjectProperty ;
                  rdfs:domain dici_onto:Attribute ;
                  rdfs:range qudt:Unit ;
                  rdfs:label "has unit" .


###  https://digicities.info/ontology#hasWindAttribute
dici_onto:hasWindAttribute rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf dici_onto:hasRenewableAttribute ;
                           rdfs:domain dici_onto:Wind .


###  https://digicities.info/ontology#isAttributeOf
dici_onto:isAttributeOf rdf:type owl:ObjectProperty ;
                        rdfs:domain dici_onto:Attribute ;
                        rdfs:range dici_onto:ServiceRequirement ;
                        rdfs:label "is attribute of" .


###  https://digicities.info/ontology#isDestinationOf
dici_onto:isDestinationOf rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf dici_onto:linksComponent ;
                          rdfs:domain dici_onto:Component ;
                          rdfs:range dici_onto:Flow ;
