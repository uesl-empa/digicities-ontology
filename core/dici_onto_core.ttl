dici_onto:MaterialStorage rdf:type owl:Class ;
                          rdfs:subClassOf dici_onto:Storage ;
                          rdfs:label "Material Storage" ;
                          rdfs:comment "Storage holding materials"@en ;
                          skos:example "Water reservoir, silo, warehouse, fuel depot"@en .


