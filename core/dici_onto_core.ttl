###  https://digicities.info/ontology#historicTimeSeriesReferenceOf
dici_onto:historicTimeSeriesReferenceOf rdf:type owl:DatatypeProperty ;
                                        rdfs:subPropertyOf dici_onto:timeSeriesReferenceOf ;
                                        rdfs:label "historic time series reference of"@en ;
                                        rdfs:comment "Inverse-direction reference: historical data describing an attribute"@en .


###  https://digicities.info/ontology#identifierValue
dici_onto:identifierValue rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf dici_onto:hasAttributeValue ;
                          rdfs:label "identifier value"@en ;
                          rdfs:comment "Literal value of an identifier attribute"@en .


###  https://digicities.info/ontology#liveTimeSeriesReferenceOf
dici_onto:liveTimeSeriesReferenceOf rdf:type owl:DatatypeProperty ;
                                    rdfs:subPropertyOf dici_onto:timeSeriesReferenceOf ;
                                    rdfs:label "live time series reference of"@en ;
                                    rdfs:comment "Inverse-direction reference: live data describing an attribute"@en .


###  https://digicities.info/ontology#modifier
dici_onto:modifier rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf dici_onto:assumptionDataProperty ;
                   rdfs:label "modifier"@en ;
                   rdfs:comment "Kind of modification an assumption applies (e.g. multiply, replace)"@en .


###  https://digicities.info/ontology#modifierValue
dici_onto:modifierValue rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf dici_onto:assumptionDataProperty ;
                        rdfs:label "modifier value"@en ;
                        rdfs:comment "The numeric value used by an assumption's modifier"@en .


###  https://digicities.info/ontology#hasUnitLabel
dici_onto:hasUnitLabel rdf:type owl:DatatypeProperty ;
                       rdfs:domain dici_onto:Attribute ;
                       rdfs:range xsd:string ;
                       rdfs:label "has unit label" ;
                       rdfs:comment "A human-readable string label for the unit of an attribute instance (e.g. 'KWh', 'KWh/yr', 'm2'). Used alongside qudt:unit (ObjectProperty) to provide a string representation that applications can consume directly. For CustomPhysicalRatioAttribute instances this is the primary unit expression; for Physical, UnitBasedCost, Curve, Geospatial and TimeSeries attributes it is emitted in addition to the qudt:unit IRI for backwards compatibility."@en .


###  https://digicities.info/ontology#xUnitLabel
dici_onto:xUnitLabel rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf dici_onto:hasUnitLabel ;
                     rdfs:domain dici_onto:CurveAttribute ;
                     rdfs:range xsd:string ;
                     rdfs:label "x unit label" ;
                     rdfs:comment "String label for the x-axis unit of a CurveAttribute (e.g. 'DEG_C'). Emitted alongside dici_onto:xUnit IRI for backwards compatibility."@en .


###  https://digicities.info/ontology#yUnitLabel
dici_onto:yUnitLabel rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf dici_onto:hasUnitLabel ;
                     rdfs:domain dici_onto:CurveAttribute ;
                     rdfs:range xsd:string ;
                     rdfs:label "y unit label" ;
                     rdfs:comment "String label for the y-axis unit of a CurveAttribute (e.g. 'PERCENT'). Emitted alongside dici_onto:yUnit IRI for backwards compatibility."@en .


###  https://digicities.info/ontology#numeratorUnit
dici_onto:numeratorUnit rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf owl:topDataProperty ;
                        rdfs:label "numerator unit"@en ;
                        rdfs:comment "Numerator unit of a custom physical ratio attribute"@en .


###  https://digicities.info/ontology#populationInfluenced
dici_onto:populationInfluenced rdf:type owl:DatatypeProperty ;
                               rdfs:subPropertyOf dici_onto:assumptionDataProperty ;
                               rdfs:label "population influenced"@en ;
                               rdfs:comment "Share or count of the population affected by an assumption"@en .


###  https://digicities.info/ontology#startTime
dici_onto:startTime rdf:type owl:DatatypeProperty ;
                    rdfs:domain dici_onto:TimeSeries ;
                    rdfs:range xsd:dateTime ;
                    rdfs:comment "The starting timestamp of the time series data"@en ;
                    rdfs:label "start time" .


###  https://digicities.info/ontology#storedAt
dici_onto:storedAt rdf:type owl:DatatypeProperty ;
                   rdfs:domain dici_onto:TimeSeries ;
                   rdfs:range xsd:string ;
                   rdfs:comment "The location or path where the time series data is stored"@en ;
                   rdfs:label "stored at" .


###  https://digicities.info/ontology#temporalResolution
dici_onto:temporalResolution rdf:type owl:DatatypeProperty ;
                             rdfs:domain dici_onto:TimeSeries ;
                             rdfs:range xsd:duration ;
                             rdfs:comment "The time interval between data points in the time series (e.g., PT1H for hourly, PT15M for 15-minute intervals)"@en ;
                             rdfs:label "temporal resolution" .


###  https://digicities.info/ontology#timeSeriesReferenceOf
dici_onto:timeSeriesReferenceOf rdf:type owl:DatatypeProperty ;
                                rdfs:label "time series reference of"@en ;
                                rdfs:comment "Root inverse-direction property for time series references"@en .


###  https://digicities.info/ontology#timeSeriesType
dici_onto:timeSeriesType rdf:type owl:DatatypeProperty ;
                         rdfs:domain dici_onto:TimeSeries ;
                         rdfs:range xsd:string ;
                         rdfs:comment "The type of time series: 'Historic', 'Live', or 'Future'"@en ;
                         rdfs:label "time series type" .


#################################################################
#    Classes
#################################################################

###  http://qudt.org/schema/qudt/CurrencyUnit
qudt:CurrencyUnit rdf:type owl:Class .


###  http://qudt.org/schema/qudt/QuantityKind
qudt:QuantityKind rdf:type owl:Class .


###  http://qudt.org/schema/qudt/Unit
qudt:Unit rdf:type owl:Class .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON
rdf:JSON rdf:type owl:Class .


###  https://digicities.info/ontology#Actor
dici_onto:Actor rdf:type owl:Class ;
                rdfs:subClassOf dici_onto:Component ;
                rdfs:comment "Human or organizational agent that owns, operates, or regulates components"@en ;
                rdfs:label "Actor" ;
                dici_onto:definition "Actors represent stakeholders in the energy system including operators, regulators, consumers, and policy makers"@en ;
                skos:altLabel "Stakeholder"@en ,
                              "Organisation"@en ,
                              "Operator"@en ,
                              "Owner"@en ;
                skos:example "A utility company, a grid operator, a municipality, a household, a regulator"@en ;
                skos:scopeNote "Use for humans and organisations that own, operate or regulate components. Automatic acting equipment is a Device (Actuator, Controller), not an Actor."@en .


###  https://digicities.info/ontology#ActorAttribute
dici_onto:ActorAttribute rdf:type owl:Class ;
                         rdfs:subClassOf dici_onto:ComponentAttribute ;
                         rdfs:label "Actor Attribute" ;
                         rdfs:comment "Typing marker grouping attributes that apply to a Actor; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#Actuator
dici_onto:Actuator rdf:type owl:Class ;
                   rdfs:subClassOf dici_onto:Device ;
                   rdfs:comment "Device that converts control signals into physical action"@en ;
                   rdfs:label "Actuator" ;
                   dici_onto:definition "Actuators are devices that produce motion or control mechanisms based on input signals"@en ;
                   skos:example "Valve actuator, damper motor, relay"@en .


###  https://digicities.info/ontology#ActuatorAttribute
dici_onto:ActuatorAttribute rdf:type owl:Class ;
                            rdfs:subClassOf dici_onto:DeviceAttribute ;
                            rdfs:label "Actuator Attribute" ;
                            rdfs:comment "Typing marker grouping attributes that apply to a Actuator; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#ActuatorPosition
dici_onto:ActuatorPosition rdf:type owl:Class ;
                           rdfs:subClassOf dici_onto:ActuatorAttribute ;
                           rdfs:comment "Current position or state of an actuator"@en ;
                           rdfs:label "Actuator Position" ;
                           dici_onto:hasDefaultUnit unit:PERCENT .


###  https://digicities.info/ontology#Assumption
dici_onto:Assumption rdf:type owl:Class ;
                     rdfs:label "Assumption"@en ;
                     rdfs:comment "A modification rule applied to attributes when deriving a scenario"@en ;
                     skos:altLabel "Modifier"@en ,
                                   "What-if Change"@en .


###  https://digicities.info/ontology#AssumptionSeries
dici_onto:AssumptionSeries rdf:type owl:Class ;
                           rdfs:subClassOf dici_onto:Assumption ;
                           rdfs:label "Assumption (series)"@en ;
                           rdfs:comment "Assumption modifying a series of values over time"@en .


###  https://digicities.info/ontology#AssumptionSingle
dici_onto:AssumptionSingle rdf:type owl:Class ;
                           rdfs:subClassOf dici_onto:Assumption ;
                           rdfs:label "Assumption (single value)"@en ;
                           rdfs:comment "Assumption modifying a single scalar attribute value"@en .


###  https://digicities.info/ontology#Attribute
dici_onto:Attribute rdf:type owl:Class ;
                    rdfs:subClassOf owl:Thing ;
                    rdfs:label "Attribute" ;
                    rdfs:comment "Root class for measurable or descriptive properties attached to Components"@en ;
                    skos:definition "An Attribute is a typed property-value node attached to a Component via dici_onto:hasAttribute (or a subproperty); the value itself is carried by qudt:value or another hasAttributeValue subproperty."@en ;
                    skos:altLabel "Property"@en ,
                                  "Parameter"@en ,
                                  "Field"@en ,
                                  "Variable"@en ,
                                  "Characteristic"@en ;
                    skos:example "Rated power, floor area, insulation class, electricity demand profile"@en ;
                    skos:scopeNote "Concrete attribute classes subclass BOTH a kind (PhysicalAttribute, CategoricalAttribute, DynamicAttribute, ...) AND the owning component's attribute-group class (e.g. TurbineAttribute)."@en .


###  https://digicities.info/ontology#CategoricalAttribute
dici_onto:CategoricalAttribute rdf:type owl:Class ;
                               rdfs:subClassOf dici_onto:Attribute ;
                               rdfs:label "Categorical Attribute" ;
                               rdfs:comment "Attribute whose value is one of an enumerated set of categories"@en ;
                               skos:example "Insulation class (Poor / Average / Good), tariff type (Flat / Variable / Dual)"@en ;
                               skos:scopeNote "Declare the allowed values as subclasses of the concrete attribute class."@en ;
                               skos:definition "An attribute whose value is drawn from a closed set of named categories; the allowed values are declared as subclasses of the attribute class."@en .


###  https://digicities.info/ontology#CircuitBreaker
dici_onto:CircuitBreaker rdf:type owl:Class ;
                         rdfs:subClassOf dici_onto:Switch ;
                         rdfs:comment "Switch that automatically interrupts electrical flow for safety"@en ;
                         rdfs:label "Circuit Breaker" .


###  https://digicities.info/ontology#ColdCarrier
dici_onto:ColdCarrier rdf:type owl:Class ;
                      rdfs:subClassOf dici_onto:ThermalEnergyCarrier ;
                      rdfs:label "Cold Carrier" ;
                      rdfs:comment "Thermal energy carrier delivering cooling"@en ;
                      skos:example "Chilled water, brine"@en .


###  https://digicities.info/ontology#ColdCarrierAttribute
dici_onto:ColdCarrierAttribute rdf:type owl:Class ;
                               rdfs:subClassOf dici_onto:ThermalEnergyCarrierAttribute ;
                               rdfs:label "Cold Carrier Attribute"@en ;
                               rdfs:comment "Typing marker grouping attributes that apply to a Cold Carrier; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#Component
dici_onto:Component rdf:type owl:Class ;
                    rdfs:label "Component"@en ;
                    rdfs:comment "Root class for every entity that can appear in a digital replica: infrastructure, places, actors, resources, flows and processes"@en ;
                    skos:definition "The universal base class for things that exist in a modelled system. Every domain concept that represents an entity (rather than a measurable property) must be a direct or indirect subclass of Component."@en ;
                    skos:altLabel "Entity"@en ,
                                  "System Element"@en ,
                                  "Asset"@en ;
                    skos:example "Buildings, turbines, districts, pipes, energy carriers, grid operators"@en ;
                    skos:scopeNote "Every new component type in an extension must be rdfs:subClassOf* Component or it will not appear in the platform UI. Measurable properties are NOT Components - subclass Attribute instead."@en .


###  https://digicities.info/ontology#ComponentAttribute
dici_onto:ComponentAttribute rdf:type owl:Class ;
                             rdfs:subClassOf dici_onto:Attribute ;
                             rdfs:label "Component Attribute" ;
                             rdfs:comment "Typing marker grouping attributes that apply to a Component; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#ComponentAttributeRequirement
dici_onto:ComponentAttributeRequirement rdf:type owl:Class ;
                                        rdfs:subClassOf dici_onto:ServiceRequirement ;
                                        rdfs:label "Component-Attribute Requirement" ;
                                        rdfs:comment "Service requirement demanding that a component carries a given attribute"@en .


###  https://digicities.info/ontology#ComponentComponentRequirement
dici_onto:ComponentComponentRequirement rdf:type owl:Class ;
                                        rdfs:subClassOf dici_onto:ServiceRequirement ;
                                        rdfs:label "Component-Component Requirement" ;
                                        rdfs:comment "Service requirement demanding that two components are linked"@en .


###  https://digicities.info/ontology#ComponentLink
dici_onto:ComponentLink rdf:type owl:Class ;
                        rdfs:label "Component Link"@en ;
                        rdfs:comment "Reified edge connecting two components in a scenario, via hasInputEntity and linksInputEntityTo"@en .


###  https://digicities.info/ontology#Controller
dici_onto:Controller rdf:type owl:Class ;
                     rdfs:subClassOf dici_onto:Device ;
                     rdfs:comment "Device that manages and coordinates other devices or processes"@en ;
                     rdfs:label "Controller" ;
                     dici_onto:definition "Controllers implement control logic and coordinate the operation of other system components"@en ;
                     skos:altLabel "Control Unit"@en ,
                                   "Building Management System"@en ,
                                   "BMS"@en ;
                     skos:example "Thermostat, building management system, SCADA controller"@en .


###  https://digicities.info/ontology#ControllerAttribute
dici_onto:ControllerAttribute rdf:type owl:Class ;
                              rdfs:subClassOf dici_onto:DeviceAttribute ;
                              rdfs:label "Controller Attribute" ;
                              rdfs:comment "Typing marker grouping attributes that apply to a Controller; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#ConversionProcess
dici_onto:ConversionProcess rdf:type owl:Class ;
                            rdfs:subClassOf dici_onto:Process ;
                            rdfs:comment "Process that converts one form of energy to another"@en ;
                            rdfs:label "Conversion Process" ;
                            skos:example "Gas to heat in a boiler; electricity to heat in a heat pump"@en .


###  https://digicities.info/ontology#ConversionProcessAttribute
dici_onto:ConversionProcessAttribute rdf:type owl:Class ;
                                     rdfs:subClassOf dici_onto:ProcessAttribute ;
                                     rdfs:label "Conversion Process Attribute" ;
                                     rdfs:comment "Typing marker grouping attributes that apply to a Conversion Process; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#Converter
dici_onto:Converter rdf:type owl:Class ;
                    rdfs:subClassOf dici_onto:Component ;
                    rdfs:label "Converter" ;
                    rdfs:comment "Component that transforms an input into a different output form (energy or material)"@en ;
                    skos:definition "A machine or installation that converts energy from one form or carrier to another, or transforms materials. The equipment is the Converter; the transformation activity it performs is a ConversionProcess."@en ;
                    skos:altLabel "Conversion Unit"@en ,
                                  "Transformer"@en ;
                    skos:example "Heat pump, boiler, electrolyser, turbine, inverter"@en .


###  https://digicities.info/ontology#ConverterAttribute
dici_onto:ConverterAttribute rdf:type owl:Class ;
                             rdfs:subClassOf dici_onto:ComponentAttribute ;
                             rdfs:label "Converter Attribute" ;
                             rdfs:comment "Typing marker grouping attributes that apply to a Converter; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#CurveAttribute
dici_onto:CurveAttribute rdf:type owl:Class ;
                         rdfs:subClassOf dici_onto:Attribute ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty dici_onto:xAttribute ;
                                           owl:someValuesFrom qudt:QuantityKind
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty dici_onto:xUnit ;
                                           owl:someValuesFrom qudt:Unit
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty dici_onto:yAttribute ;
                                           owl:someValuesFrom qudt:QuantityKind
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty dici_onto:yUnit ;
                                           owl:someValuesFrom qudt:Unit
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty dici_onto:hasAttributeValue ;
                                           owl:someValuesFrom rdfs:Literal
                                         ] ;
                         rdfs:label "Curve Attribute" ;
                         dici_onto:definition "An attribute represented by a set of x,y coordinate pairs forming a curve"@en ;
                         rdfs:comment "Attribute represented by x-y coordinate pairs forming a curve"@en ;
                         skos:example "Heat pump COP as a function of outdoor temperature"@en .


###  https://digicities.info/ontology#CustomPhysicalRatioAttribute
dici_onto:CustomPhysicalRatioAttribute rdf:type owl:Class ;
                                       rdfs:subClassOf dici_onto:Attribute ;
                                       rdfs:label "Custom Physical Ratio Attribute" ;
                                       rdfs:comment "An attribute whose unit is a ratio of two QUDT units (numerator/denominator). The ratio is expressed as a human-readable string via dici_onto:hasUnitLabel (e.g. 'KWh/yr'). The constituent units are constrained by dici_onto:hasRatioUnits on the subclass definition. Unlike Physical attributes, no qudt:unit IRI is emitted for this type — dici_onto:hasUnitLabel is the sole unit representation."@en .


###  https://digicities.info/ontology#Damper
dici_onto:Damper rdf:type owl:Class ;
                 rdfs:subClassOf dici_onto:Actuator ;
                 rdfs:comment "Actuator that controls air flow"@en ;
                 rdfs:label "Damper" .


###  https://digicities.info/ontology#Device
dici_onto:Device rdf:type owl:Class ;
                 rdfs:subClassOf dici_onto:Component ;
                 rdfs:comment "Physical or virtual devices that monitor, control, or measure components in the energy system"@en ;
                 rdfs:label "Device" ;
                 dici_onto:definition "Devices are components that provide sensing, actuation, measurement, or control capabilities within the energy system"@en ;
                 skos:altLabel "Equipment"@en ,
                               "Instrument"@en ;
                 skos:example "Sensors, meters, controllers, switches, actuators"@en ;
                 skos:scopeNote "Use for monitoring, control and measurement equipment. Machinery that converts or stores energy belongs under Converter or Storage, not Device."@en .


###  https://digicities.info/ontology#DeviceAttribute
dici_onto:DeviceAttribute rdf:type owl:Class ;
                          rdfs:subClassOf dici_onto:ComponentAttribute ;
                          rdfs:label "Device Attribute" ;
                          rdfs:comment "Typing marker grouping attributes that apply to a Device; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#DynamicAttribute
dici_onto:DynamicAttribute rdf:type owl:Class ;
                           rdfs:subClassOf dici_onto:Attribute ;
                           rdfs:label "Dynamic Attribute" ;
                           rdfs:comment "Attribute whose value varies over time and is backed by time series data"@en ;
                           skos:example "Electricity demand profile, wind speed series, outdoor temperature"@en ;
                           skos:scopeNote "Link the data via hasTimeSeries or the time-series reference properties; forecasts use FutureTimeSeries, measurements HistoricTimeSeries."@en ;
                           skos:definition "An attribute whose value is a function of time rather than a single number; its data lives in linked TimeSeries nodes or external time series references."@en .


###  https://digicities.info/ontology#Efficiency
dici_onto:Efficiency rdf:type owl:Class ;
                     rdfs:subClassOf dici_onto:ConversionProcessAttribute ;
                     rdfs:comment "Conversion efficiency of a process"@en ;
                     rdfs:label "Efficiency" ;
                     dici_onto:hasDefaultUnit unit:PERCENT .


###  https://digicities.info/ontology#ElectricityCarrier
dici_onto:ElectricityCarrier rdf:type owl:Class ;
                             rdfs:subClassOf dici_onto:EnergyCarrier ;
                             rdfs:label "Electricity Carrier" ;
                             rdfs:comment "Energy carrier for electrical energy"@en ;
                             skos:example "Grid electricity, self-generated PV electricity"@en .


###  https://digicities.info/ontology#ElectricityCarrierAttribute
dici_onto:ElectricityCarrierAttribute rdf:type owl:Class ;
                                      rdfs:subClassOf dici_onto:EnergyCarrierAttribute ;
                                      rdfs:label "Electricity Carrier Attribute"@en ;
                                      rdfs:comment "Typing marker grouping attributes that apply to a Electricity Carrier; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#ElectricityDemandProfile
dici_onto:ElectricityDemandProfile rdf:type owl:Class ;
                                   rdfs:subClassOf dici_onto:DynamicAttribute ;
                                   rdfs:comment "A dynamic attribute representing the electricity demand over time"@en ;
                                   rdfs:label "Electricity Demand Profile" ;
                                   dici_onto:hasDefaultUnit unit:KiloW ;
                                   dici_onto:hasQuantityKind qudt:Power .


###  https://digicities.info/ontology#ElectricityFlow
dici_onto:ElectricityFlow rdf:type owl:Class ;
                          rdfs:subClassOf dici_onto:EnergyCarrierFlow ;
                          rdfs:label "Electricity Flow" ;
                          dici_onto:hasDefaultUnit unit:KiloW ;
                          rdfs:comment "Flow of electrical energy between components"@en .


###  https://digicities.info/ontology#ElectricityMeter
dici_onto:ElectricityMeter rdf:type owl:Class ;
                           rdfs:subClassOf dici_onto:Meter ;
                           rdfs:label "Electricity Meter" ;
                           dici_onto:hasDefaultUnit unit:KiloW-HR ;
                           rdfs:comment "Meter recording cumulative electrical energy consumption or production"@en .


###  https://digicities.info/ontology#EnergyCarrier
dici_onto:EnergyCarrier rdf:type owl:Class ;
                        rdfs:subClassOf dici_onto:Component ;
                        rdfs:label "Energy Carrier" ;
                        rdfs:comment "The medium or commodity form in which energy is stored, transported and consumed"@en ;
                        skos:definition "An energy vector: the commodity that carries energy through the system, independent of the infrastructure that moves it."@en ;
                        skos:altLabel "Energy Vector"@en ,
                                      "Energy Commodity"@en ;
                        skos:example "Electricity, district heat, natural gas, hydrogen, biomass"@en ;
                        skos:scopeNote "EnergyCarrier is the commodity (what), Flow is its movement (the transfer), Network is the infrastructure it moves through."@en .


###  https://digicities.info/ontology#EnergyCarrierAttribute
dici_onto:EnergyCarrierAttribute rdf:type owl:Class ;
                                 rdfs:subClassOf dici_onto:ComponentAttribute ;
                                 rdfs:label "Energy Carrier Attribute"@en ;
                                 rdfs:comment "Typing marker grouping attributes that apply to a Energy Carrier; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#EnergyCarrierFlow
dici_onto:EnergyCarrierFlow rdf:type owl:Class ;
                            rdfs:subClassOf dici_onto:Flow ;
                            rdfs:comment "Flow of energy carriers between components"@en ;
                            rdfs:label "Energy Carrier Flow" ;
                            skos:example "Electricity flow, heat flow, gas flow"@en .


###  https://digicities.info/ontology#EnergyCarrierFlowAttribute
dici_onto:EnergyCarrierFlowAttribute rdf:type owl:Class ;
                                     rdfs:subClassOf dici_onto:FlowAttribute ;
                                     rdfs:label "Energy Carrier Flow Attribute" ;
                                     rdfs:comment "Typing marker grouping attributes that apply to a Energy Carrier Flow; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#EnergyConsumer
dici_onto:EnergyConsumer rdf:type owl:Class ;
                         rdfs:subClassOf dici_onto:Component ;
                         rdfs:label "Energy Consumer" ;
                         rdfs:comment "Component whose primary role is to consume energy"@en ;
                         skos:altLabel "Load"@en ,
                                       "Demand"@en ,
                                       "Energy Sink"@en ;
                         skos:example "A building heating load, an EV charging station, an industrial process line"@en ;
                         skos:scopeNote "Use for demand-side entities. A component that transforms energy onward rather than consuming it is a Converter."@en ;
                         skos:definition "A component that takes energy out of the system for an end use. Consumers are the demand side: they receive flows but do not transform them into another carrier."@en .


###  https://digicities.info/ontology#EnergyConsumerAttribute
dici_onto:EnergyConsumerAttribute rdf:type owl:Class ;
                                  rdfs:subClassOf dici_onto:ComponentAttribute ;
                                  rdfs:label "Energy Consumer Attribute"@en ;
                                  rdfs:comment "Typing marker grouping attributes that apply to a Energy Consumer; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#EnergyConverter
dici_onto:EnergyConverter rdf:type owl:Class ;
                          rdfs:subClassOf dici_onto:Converter ;
                          rdfs:label "Energy Converter" ;
                          rdfs:comment "Converter transforming energy between carriers or forms"@en ;
                          skos:example "Heat pump, boiler, fuel cell, inverter, wind turbine generator"@en .


###  https://digicities.info/ontology#EnergyConverterAttribute
dici_onto:EnergyConverterAttribute rdf:type owl:Class ;
                                   rdfs:subClassOf dici_onto:ConverterAttribute ;
                                   rdfs:label "Energy Converter Attribute"@en ;
                                   rdfs:comment "Typing marker grouping attributes that apply to a Energy Converter; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#EnergyGenerator
dici_onto:EnergyGenerator rdf:type owl:Class ;
                          rdfs:subClassOf dici_onto:Component ;
                          rdfs:label "Energy Generator" ;
                          rdfs:comment "Component whose primary role is to produce energy"@en ;
                          skos:altLabel "Generator"@en ,
                                        "Producer"@en ,
                                        "Power Plant"@en ,
                                        "Energy Source"@en ;
                          skos:example "PV plant, diesel genset, CHP unit"@en ;
                          skos:scopeNote "The generating equipment is an EnergyGenerator (or a Converter subclass such as Turbine); the site it stands on (e.g. a wind park as a place) is a Location."@en ;
                          skos:definition "A component that injects energy into the system. Generators are the supply side: the equipment that produces an energy carrier from a resource or fuel."@en .


###  https://digicities.info/ontology#EnergyGeneratorAttribute
dici_onto:EnergyGeneratorAttribute rdf:type owl:Class ;
                                   rdfs:subClassOf dici_onto:ComponentAttribute ;
                                   rdfs:label "EnergyGenerator Attribute" ;
                                   rdfs:comment "Typing marker grouping attributes that apply to a Energy Generator; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


