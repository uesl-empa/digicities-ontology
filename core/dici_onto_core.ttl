@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dici_onto: <https://digicities.info/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

qudt:numericValue a owl:DatatypeProperty .

qudt:unit a owl:ObjectProperty ;
    rdfs:domain dici_onto:Attribute ;
    rdfs:range qudt:Unit ;
    rdfs:subPropertyOf dici_onto:hasUnit .

qudt:value a owl:DatatypeProperty ;
    rdfs:domain dici_onto:Attribute ;
    rdfs:subPropertyOf dici_onto:hasAttributeValue .

skos:example a owl:AnnotationProperty .

skos:scopeNote a owl:AnnotationProperty .

dici_onto:AssumptionSingle a owl:Class ;
    rdfs:label "Assumption (single value)"@en ;
    rdfs:comment "Assumption modifying a single scalar attribute value"@en ;
    rdfs:subClassOf dici_onto:Assumption .

dici_onto:Author a owl:AnnotationProperty ;
    rdfs:label "author"@en ;
    rdfs:comment "Provenance annotation naming the author of a term or graph"@en .

dici_onto:Collaborator a owl:AnnotationProperty ;
    rdfs:label "collaborator"@en ;
    rdfs:comment "Provenance annotation naming a collaborator on a term or graph"@en .

dici_onto:ComponentAttributeRequirement a owl:Class ;
    rdfs:label "Component-Attribute Requirement" ;
    rdfs:comment "Service requirement demanding that a component carries a given attribute"@en ;
    rdfs:subClassOf dici_onto:ServiceRequirement .

dici_onto:ComponentComponentRequirement a owl:Class ;
    rdfs:label "Component-Component Requirement" ;
    rdfs:comment "Service requirement demanding that two components are linked"@en ;
    rdfs:subClassOf dici_onto:ServiceRequirement .

dici_onto:CustomPhysicalRatioAttribute a owl:Class ;
    rdfs:label "Custom Physical Ratio Attribute" ;
    rdfs:comment "An attribute whose unit is a ratio of two QUDT units (numerator/denominator). The ratio is expressed as a human-readable string via dici_onto:hasUnitLabel (e.g. 'KWh/yr'). The constituent units are constrained by dici_onto:hasRatioUnits on the subclass definition. Unlike Physical attributes, no qudt:unit IRI is emitted for this type — dici_onto:hasUnitLabel is the sole unit representation."@en ;
    rdfs:subClassOf dici_onto:Attribute .

dici_onto:DOI a owl:NamedIndividual,
        dici_onto:ReferenceType ;
    rdfs:label "DOI" ;
    rdfs:comment "Reference identified by a Digital Object Identifier"@en .

dici_onto:DataPathAttribute a owl:Class ;
    rdfs:label "Data Path Attribute" ;
    rdfs:comment "Attribute whose value is a path or reference to a data file, read through hasDataPath"@en ;
    rdfs:subClassOf dici_onto:Attribute .

dici_onto:Date a owl:NamedIndividual,
        dici_onto:TemporalPrecision ;
    rdfs:label "Date" ;
    rdfs:comment "Temporal precision of a calendar date (day)"@en .

dici_onto:DateTime a owl:NamedIndividual,
        dici_onto:TemporalPrecision ;
    rdfs:label "Date-Time" ;
    rdfs:comment "Temporal precision of a date with time of day"@en .

dici_onto:ElectricityDemandProfile a owl:Class ;
    rdfs:label "Electricity Demand Profile" ;
    rdfs:comment "A dynamic attribute representing the electricity demand over time"@en ;
    rdfs:subClassOf dici_onto:DynamicAttribute ;
    dici_onto:hasDefaultUnit unit:KiloW ;
    dici_onto:hasQuantityKind qudt:Power .

dici_onto:GeospatialAttribute a owl:Class ;
    rdfs:label "Geospatial Attribute" ;
    rdfs:comment "Attribute holding geographic data such as coordinates or geometries"@en ;
    rdfs:subClassOf dici_onto:Attribute ;
    skos:definition "An attribute whose value is geographic: coordinates, geometries or other spatial references locating a component on a map."@en ;
    skos:example "Latitude and longitude of a site; a boundary polygon"@en .

dici_onto:IdentifierAttribute a owl:Class ;
    rdfs:label "Identifier Attribute" ;
    rdfs:comment "Attribute whose value identifies the thing it belongs to, reached through hasIdentifier"@en ;
    rdfs:subClassOf dici_onto:Attribute .

dici_onto:Institution a owl:AnnotationProperty ;
    rdfs:label "institution"@en ;
    rdfs:comment "Provenance annotation naming the institution behind a term or graph"@en .

dici_onto:LiquidFuelCarrierAttribute a owl:Class ;
    rdfs:label "Liquid Fuel Carrier Attribute"@en ;
    rdfs:comment "Deprecated in v0.6.0: use LiquidFuelAttribute. Kept for one release."@en ;
    owl:deprecated true ;
    owl:equivalentClass dici_onto:LiquidFuelAttribute .

dici_onto:SimpleCostAttribute a owl:Class ;
    rdfs:label "Simple Cost Attribute" ;
    rdfs:comment "Attribute holding a plain monetary value"@en ;
    rdfs:subClassOf dici_onto:Attribute ;
    skos:example "Investment cost in EUR"@en .

dici_onto:SolidFuelCarrierAttribute a owl:Class ;
    rdfs:label "Solid Fuel Carrier Attribute"@en ;
    rdfs:comment "Deprecated in v0.6.0: use SolidFuelAttribute. Kept for one release."@en ;
    owl:deprecated true ;
    owl:equivalentClass dici_onto:SolidFuelAttribute .

dici_onto:StaticAttribute a owl:Class ;
    rdfs:label "Static Attribute" ;
    rdfs:comment "Attribute whose value does not change over the modelled time horizon"@en ;
    rdfs:subClassOf dici_onto:Attribute .

dici_onto:Synonymous a owl:AnnotationProperty ;
    rdfs:label "synonymous"@en ;
    rdfs:comment "Legacy synonym annotation; prefer skos:altLabel for new terms"@en ;
    rdfs:subPropertyOf skos:altLabel .

dici_onto:UnitBasedCostAttribute a owl:Class ;
    rdfs:label "Unit Based Cost Attribute" ;
    rdfs:comment "Attribute holding a cost per unit of some quantity"@en ;
    rdfs:subClassOf dici_onto:Attribute ;
    skos:example "Energy price in EUR per kWh"@en .

dici_onto:Unknown a owl:NamedIndividual,
        dici_onto:TemporalPrecision ;
    rdfs:label "Unknown" ;
    rdfs:comment "Temporal precision is not known"@en .

dici_onto:WindResourceAttribute a owl:Class ;
    rdfs:label "Wind Resource Attribute"@en ;
    rdfs:comment "Deprecated in v0.6.0: use WindAttribute. Kept for one release."@en ;
    owl:deprecated true ;
    owl:equivalentClass dici_onto:WindAttribute .

dici_onto:Year a owl:NamedIndividual,
        dici_onto:TemporalPrecision ;
    rdfs:label "Year" ;
    rdfs:comment "Temporal precision of a calendar year"@en .

dici_onto:YearMonth a owl:NamedIndividual,
        dici_onto:TemporalPrecision ;
    rdfs:label "Year-Month" ;
    rdfs:comment "Temporal precision of a year and month"@en .

dici_onto:abbreviation a owl:AnnotationProperty ;
    rdfs:label "abbreviation"@en ;
    rdfs:comment "Legacy abbreviation annotation; prefer skos:altLabel for new terms"@en ;
    rdfs:subPropertyOf skos:altLabel .

dici_onto:actuates a owl:ObjectProperty ;
    rdfs:label "actuates" ;
    rdfs:comment "Actuator physically controls a component"@en ;
    rdfs:domain dici_onto:Actuator ;
    rdfs:range dici_onto:Component ;
    rdfs:subPropertyOf dici_onto:controls .

dici_onto:aggregateOf a owl:ObjectProperty ;
    rdfs:label "aggregate of" ;
    rdfs:comment "Links a projected aggregate attribute node back to the group Set it summarizes — the Set carries the full statistics and membership."@en ;
    rdfs:domain dici_onto:AggregateAttribute ;
    rdfs:range dici_onto:Set .

dici_onto:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to"@en ;
    rdfs:comment "A component a ServiceConfiguration profile is tuned for (the wind park a wake-model setup was calibrated on). Not a linksComponent subproperty: it is not system topology."@en ;
    rdfs:domain dici_onto:ServiceConfiguration ;
    rdfs:range dici_onto:Component .

dici_onto:assumptionApplied a owl:DatatypeProperty ;
    rdfs:label "assumption applied" ;
    rdfs:comment "Name of an assumption applied when deriving this scenario. Scenario-provenance metadata written by the platform tooling"@en ;
    rdfs:domain dici_onto:Scenario ;
    rdfs:range xsd:string .

dici_onto:assumptionId a owl:DatatypeProperty ;
    rdfs:label "assumption id" ;
    rdfs:comment "Identifier of an assumption applied when deriving this scenario. Scenario-provenance metadata"@en ;
    rdfs:domain dici_onto:Scenario ;
    rdfs:range xsd:string .

dici_onto:assumptionTimesteps a owl:DatatypeProperty ;
    rdfs:label "assumption timesteps"@en ;
    rdfs:comment "The timesteps at which an assumption series applies"@en ;
    rdfs:domain dici_onto:AssumptionSeries ;
    rdfs:subPropertyOf dici_onto:assumptionDataProperty .

dici_onto:assumptionType a owl:DatatypeProperty ;
    rdfs:label "assumption type" ;
    rdfs:comment "Kind of assumption applied when deriving this scenario (e.g. single value or series). Scenario-provenance metadata"@en ;
    rdfs:domain dici_onto:Scenario ;
    rdfs:range xsd:string .

dici_onto:basedOn a owl:ObjectProperty ;
    rdfs:label "based on"@en ;
    rdfs:comment "Links a derived scenario to the baseline scenario it was derived from. Scenario-provenance link written by the platform assumptions tooling"@en ;
    rdfs:domain dici_onto:Scenario ;
    rdfs:range dici_onto:Scenario .

dici_onto:binFrequency a owl:DatatypeProperty ;
    rdfs:label "bin frequency" ;
    rdfs:comment "How many of the Set's values fall in this bin."@en ;
    rdfs:range xsd:integer .

dici_onto:binLabel a owl:DatatypeProperty ;
    rdfs:label "bin label" ;
    rdfs:comment "Human-readable bin identity: a numeric range like [300, 400) or a category value."@en .

dici_onto:binLowerBound a owl:DatatypeProperty ;
    rdfs:label "bin lower bound" ;
    rdfs:comment "Inclusive lower bound of a numeric histogram bin."@en ;
    rdfs:range xsd:double .

dici_onto:binUpperBound a owl:DatatypeProperty ;
    rdfs:label "bin upper bound" ;
    rdfs:comment "Exclusive upper bound of a numeric histogram bin (the last bin is closed)."@en ;
    rdfs:range xsd:double .

dici_onto:builtForService a owl:DatatypeProperty ;
    rdfs:label "built for service" ;
    rdfs:comment "Name of the service a scenario was assembled for. Scenario-provenance metadata"@en ;
    rdfs:domain dici_onto:Scenario ;
    rdfs:range xsd:string .

dici_onto:carriesEnergyCarrier a owl:ObjectProperty ;
    rdfs:label "carries energy carrier" ;
    rdfs:comment "The energy carrier being transported by the flow"@en ;
    rdfs:domain dici_onto:EnergyCarrierFlow ;
    rdfs:range dici_onto:EnergyCarrier ;
    rdfs:subPropertyOf dici_onto:carriesResource .

dici_onto:computedAt a owl:DatatypeProperty ;
    rdfs:label "computed at" ;
    rdfs:comment "When this Collection was materialized. A Collection older than its workspace's last data load is stale."@en ;
    rdfs:range xsd:dateTime .

dici_onto:computedBy a owl:DatatypeProperty ;
    rdfs:label "computed by" ;
    rdfs:comment "Identifier/version of the service that materialized this Collection."@en .

dici_onto:configures a owl:ObjectProperty ;
    rdfs:label "configures"@en ;
    rdfs:comment "The Service a ServiceConfiguration profile belongs to (inverse of hasConfiguration)."@en ;
    rdfs:domain dici_onto:ServiceConfiguration ;
    rdfs:range dici_onto:Service ;
    owl:inverseOf dici_onto:hasConfiguration .

dici_onto:contains a owl:ObjectProperty ;
    rdfs:label "contains"@en ;
    rdfs:comment "A component spatially or logically contains another component"@en ;
    rdfs:subPropertyOf dici_onto:linksComponent .

dici_onto:cost a owl:DatatypeProperty ;
    rdfs:label "cost" ;
    rdfs:comment "Monetary cost literal attached to an attribute node by the scenario tooling. For modelled costs prefer the cost attribute classes (SimpleCostAttribute, UnitBasedCostAttribute)"@en ;
    rdfs:domain dici_onto:Attribute .

dici_onto:count a owl:DatatypeProperty ;
    rdfs:label "count" ;
    rdfs:comment "How many values the Set aggregates."@en ;
    rdfs:range xsd:integer .

dici_onto:createdInWorkspace a owl:DatatypeProperty ;
    rdfs:label "created in workspace" ;
    rdfs:comment "Identifier of the workspace a scenario was created in. Scenario-provenance metadata"@en ;
    rdfs:domain dici_onto:Scenario ;
    rdfs:range xsd:string .

dici_onto:currency a owl:ObjectProperty ;
    rdfs:label "currency" ;
    rdfs:comment "Currency unit of a cost attribute"@en ;
    rdfs:range qudt:CurrencyUnit ;
    rdfs:subPropertyOf owl:topObjectProperty .

dici_onto:definition a owl:AnnotationProperty ;
    rdfs:label "definition"@en ;
    rdfs:comment "Legacy definition annotation; prefer skos:definition for new terms"@en ;
    rdfs:subPropertyOf skos:definition .

dici_onto:denominatorUnit a owl:DatatypeProperty ;
    rdfs:label "denominator unit"@en ;
    rdfs:comment "Denominator unit of a custom physical ratio attribute"@en .

dici_onto:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived from"@en ;
    rdfs:comment "Scenario provenance: this scenario was derived from another scenario"@en ;
    rdfs:domain dici_onto:Scenario ;
    rdfs:range dici_onto:Scenario .

dici_onto:derivedFromCatalogue a owl:ObjectProperty ;
    rdfs:label "derived from catalogue"@en ;
    rdfs:comment "Links a sited component instance to the catalogue or manufacturer-specification entry of the same class its values were taken from."@en ;
    rdfs:domain dici_onto:Component ;
    rdfs:range dici_onto:Component ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    skos:definition "Provenance link from a real, sited instance (a turbine in a park) to the catalogue entry (its turbine type) that specifies it. Not a linksComponent subproperty: it records where values came from, not how the system is connected."@en ;
    skos:example "WindTurbine Alkmaar_1 derivedFromCatalogue the WindTurbine catalogue entry alkmaar_2p3MW"@en .

dici_onto:derivedFromDataSet a owl:ObjectProperty ;
    rdfs:label "derived from data set" ;
    rdfs:comment "Provenance link from a Collection back to the data source (Reference) it was restricted to. Absent when the Collection covers the whole workspace replica."@en ;
    rdfs:domain dici_onto:Collection ;
    owl:inverseOf dici_onto:hasSet .

dici_onto:distinctCount a owl:DatatypeProperty ;
    rdfs:label "distinct count" ;
    rdfs:comment "How many distinct values occur in the Set."@en ;
    rdfs:range xsd:integer .

dici_onto:endTime a owl:DatatypeProperty ;
    rdfs:label "end time" ;
    rdfs:comment "The ending timestamp of the time series data"@en ;
    rdfs:domain dici_onto:TimeSeries ;
    rdfs:range xsd:dateTime .

dici_onto:fedBy a owl:ObjectProperty ;
    rdfs:label "fed by"@en ;
    rdfs:comment "Supply relationship: this component is fed by another component"@en ;
    rdfs:domain dici_onto:Component ;
    rdfs:range dici_onto:Component ;
    rdfs:subPropertyOf dici_onto:linksComponent ;
    owl:inverseOf dici_onto:feeds .

dici_onto:flowsThrough a owl:ObjectProperty ;
    rdfs:label "flows through" ;
    rdfs:comment "Locations traversed by a flow"@en ;
    rdfs:domain dici_onto:Flow ;
    rdfs:range dici_onto:Location ;
    rdfs:subPropertyOf dici_onto:linksComponent .

dici_onto:futureTimeSeriesOf a owl:DatatypeProperty ;
    rdfs:label "future time series of"@en ;
    rdfs:comment "Inverse-direction reference: forecast data describing an attribute"@en ;
    rdfs:subPropertyOf dici_onto:timeSeriesReferenceOf .

dici_onto:generatedBy a owl:DatatypeProperty ;
    rdfs:label "generated by" ;
    rdfs:comment "Tool or module that generated the scenario. Scenario-provenance metadata"@en ;
    rdfs:domain dici_onto:Scenario ;
    rdfs:range xsd:string .

dici_onto:groupComponent a owl:ObjectProperty ;
    rdfs:label "group component" ;
    rdfs:comment "The component instance whose linked components this group's members belong to. Present only on Sets of a component-grouped GroupedSet."@en ;
    rdfs:domain dici_onto:Set .

dici_onto:groupKey a owl:DatatypeProperty ;
    rdfs:label "group key" ;
    rdfs:comment "The raw value of the grouping attribute — or the label of the grouping component instance — for this partition. Present only on Sets that are members of a GroupedSet."@en ;
    rdfs:domain dici_onto:Set .

dici_onto:groupedBy a owl:ObjectProperty ;
    rdfs:label "grouped by" ;
    rdfs:comment "What partitions the members: an attribute class whose values are the group keys (class-as-value, e.g. dici_onto:PostalCode), or a component class whose instances are the groups — each member's owner is linked to that instance via a linksComponent-family edge (e.g. dici_onto:WindPark for per-park turbine statistics)."@en ;
    rdfs:domain dici_onto:GroupedSet .

dici_onto:hasActorAttribute a owl:ObjectProperty ;
    rdfs:label "has actor attribute" ;
    rdfs:comment "Attaches a Actor attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:Actor ;
    rdfs:range dici_onto:ActorAttribute ;
    rdfs:subPropertyOf dici_onto:hasComponentAttribute .

dici_onto:hasActuatorActuatorPositionAttribute a owl:ObjectProperty ;
    rdfs:label "has actuator actuator position attribute"@en ;
    rdfs:comment "Links an Actuator to its Actuator Position attribute; under hasActuatorAttribute"@en ;
    rdfs:domain dici_onto:Actuator ;
    rdfs:range dici_onto:ActuatorPosition ;
    rdfs:subPropertyOf dici_onto:hasActuatorAttribute .

dici_onto:hasAnnotationValue a owl:DatatypeProperty ;
    rdfs:label "has annotation value"@en ;
    rdfs:comment "The free-text content of an annotation attribute"@en ;
    rdfs:domain dici_onto:AnnotationAttribute ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dici_onto:hasAttributeValue .

dici_onto:hasBin a owl:ObjectProperty ;
    rdfs:label "has bin" ;
    rdfs:comment "One bin of this Distribution."@en ;
    rdfs:domain dici_onto:Distribution ;
    rdfs:range dici_onto:DistributionBin .

dici_onto:hasCategoricalValue a owl:DatatypeProperty ;
    rdfs:label "has categorical value"@en ;
    rdfs:comment "The selected category value of a categorical attribute"@en ;
    rdfs:subPropertyOf dici_onto:hasAttributeValue .

dici_onto:hasCircuitBreakerAttribute a owl:ObjectProperty ;
    rdfs:label "has circuit breaker attribute"@en ;
    rdfs:comment "Attaches a Circuit Breaker attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:CircuitBreaker ;
    rdfs:range dici_onto:CircuitBreakerAttribute ;
    rdfs:subPropertyOf dici_onto:hasSwitchAttribute .

dici_onto:hasColdAttribute a owl:ObjectProperty ;
    rdfs:label "has cold attribute"@en ;
    rdfs:comment "Deprecated in v0.6.0: use hasColdCarrierAttribute. Kept for one release."@en ;
    rdfs:subPropertyOf dici_onto:hasColdCarrierAttribute ;
    owl:deprecated true ;
    owl:equivalentProperty dici_onto:hasColdCarrierAttribute .

dici_onto:hasCompositeWeatherObservationAttribute a owl:ObjectProperty ;
    rdfs:label "has composite weather observation attribute"@en ;
    rdfs:comment "Attaches a Composite Weather Observation attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:CompositeWeatherObservation ;
    rdfs:range dici_onto:CompositeWeatherObservationAttribute ;
    rdfs:subPropertyOf dici_onto:hasWeatherObservationAttribute .

dici_onto:hasConfigurationParameter a owl:ObjectProperty ;
    rdfs:label "has configuration parameter"@en ;
    rdfs:comment "Attaches a configuration parameter (a ConfigurationAttribute node with its value) to its ServiceConfiguration profile."@en ;
    rdfs:domain dici_onto:ServiceConfiguration ;
    rdfs:range dici_onto:ConfigurationAttribute .

dici_onto:hasControllerSetPointAttribute a owl:ObjectProperty ;
    rdfs:label "has controller set point attribute"@en ;
    rdfs:comment "Links a Controller to its Set Point attribute; under hasControllerAttribute"@en ;
    rdfs:domain dici_onto:Controller ;
    rdfs:range dici_onto:SetPoint ;
    rdfs:subPropertyOf dici_onto:hasControllerAttribute .

dici_onto:hasConversionProcessEfficiencyAttribute a owl:ObjectProperty ;
    rdfs:label "has conversion process efficiency attribute"@en ;
    rdfs:comment "Links a Conversion Process to its Efficiency attribute; under hasConversionProcessAttribute"@en ;
    rdfs:domain dici_onto:ConversionProcess ;
    rdfs:range dici_onto:Efficiency ;
    rdfs:subPropertyOf dici_onto:hasConversionProcessAttribute .

dici_onto:hasDamperAttribute a owl:ObjectProperty ;
    rdfs:label "has damper attribute"@en ;
    rdfs:comment "Attaches a Damper attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:Damper ;
    rdfs:range dici_onto:DamperAttribute ;
    rdfs:subPropertyOf dici_onto:hasActuatorAttribute .

dici_onto:hasDataPath a owl:DatatypeProperty ;
    rdfs:label "has data path" ;
    rdfs:comment "Path to an external data file backing an attribute value (e.g. a curve or a weather file)"@en ;
    rdfs:domain dici_onto:Attribute ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dici_onto:hasAttributeValue .

dici_onto:hasDataPoints a owl:DatatypeProperty ;
    rdfs:label "has data points"@en ;
    rdfs:comment "The x-y data points of a curve attribute, as JSON"@en ;
    rdfs:domain dici_onto:CurveAttribute ;
    rdfs:range rdf:JSON ;
    rdfs:subPropertyOf dici_onto:hasAttributeValue .

dici_onto:hasDefaultTemporalPrecision a owl:AnnotationProperty ;
    rdfs:label "has default temporal precision"@en ;
    rdfs:comment "Annotation on an event attribute class giving the default temporal precision (a TemporalPrecision individual) for its instances. Class-level counterpart of hasTemporalPrecision, mirroring hasDefaultUnit"@en ;
    rdfs:domain dici_onto:EventAttribute ;
    rdfs:range dici_onto:TemporalPrecision .

dici_onto:hasDefaultUnit a owl:AnnotationProperty ;
    rdfs:label "has default unit"@en ;
    rdfs:comment "Annotation on an attribute class giving the default QUDT unit for its instances"@en ;
    rdfs:domain dici_onto:Attribute ;
    rdfs:range qudt:Unit .

dici_onto:hasDescriptiveStatistics a owl:ObjectProperty ;
    rdfs:label "has descriptive statistics" ;
    rdfs:comment "The aggregate statistics computed over this Set's members."@en ;
    rdfs:domain dici_onto:Set ;
    rdfs:range dici_onto:DescriptiveStatistics .

dici_onto:hasDestination a owl:ObjectProperty ;
    rdfs:label "has destination" ;
    rdfs:comment "The component to which the flow is directed"@en ;
    rdfs:domain dici_onto:Flow ;
    rdfs:range dici_onto:Component ;
    rdfs:subPropertyOf dici_onto:linksComponent ;
    owl:inverseOf dici_onto:isDestinationOf .

dici_onto:hasDeviceMeasurementAccuracyAttribute a owl:ObjectProperty ;
    rdfs:label "has device measurement accuracy attribute"@en ;
    rdfs:comment "Links a Device to its Measurement Accuracy attribute; under hasDeviceAttribute"@en ;
    rdfs:domain dici_onto:Device ;
    rdfs:range dici_onto:MeasurementAccuracy ;
    rdfs:subPropertyOf dici_onto:hasDeviceAttribute .

dici_onto:hasDistribution a owl:ObjectProperty ;
    rdfs:label "has distribution" ;
    rdfs:comment "The binned/frequency representation of this Set's values."@en ;
    rdfs:domain dici_onto:Set ;
    rdfs:range dici_onto:Distribution .

dici_onto:hasElectricityAttribute a owl:ObjectProperty ;
    rdfs:label "has electricity attribute"@en ;
    rdfs:comment "Deprecated in v0.6.0: use hasElectricityCarrierAttribute. Kept for one release."@en ;
    rdfs:subPropertyOf dici_onto:hasElectricityCarrierAttribute ;
    owl:deprecated true ;
    owl:equivalentProperty dici_onto:hasElectricityCarrierAttribute .

dici_onto:hasElectricityFlowAttribute a owl:ObjectProperty ;
    rdfs:label "has electricity flow attribute"@en ;
    rdfs:comment "Attaches an Electricity Flow attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:ElectricityFlow ;
    rdfs:range dici_onto:ElectricityFlowAttribute ;
    rdfs:subPropertyOf dici_onto:hasEnergyCarrierFlowAttribute .

dici_onto:hasElectricityMeterAttribute a owl:ObjectProperty ;
    rdfs:label "has electricity meter attribute"@en ;
    rdfs:comment "Attaches an Electricity Meter attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:ElectricityMeter ;
    rdfs:range dici_onto:ElectricityMeterAttribute ;
    rdfs:subPropertyOf dici_onto:hasMeterAttribute .

dici_onto:hasEnergyConsumerAttribute a owl:ObjectProperty ;
    rdfs:label "has energy consumer attribute"@en ;
    rdfs:comment "Attaches a Energy Consumer attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:EnergyConsumer ;
    rdfs:range dici_onto:EnergyConsumerAttribute ;
    rdfs:subPropertyOf dici_onto:hasComponentAttribute .

dici_onto:hasEnergyGeneratorAttribute a owl:ObjectProperty ;
    rdfs:label "has energy generator attribute"@en ;
    rdfs:comment "Attaches a Energy Generator attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:EnergyGenerator ;
    rdfs:range dici_onto:EnergyGeneratorAttribute ;
