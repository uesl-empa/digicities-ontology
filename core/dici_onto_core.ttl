                               rdfs:subClassOf dici_onto:Resource ;
                               rdfs:label "Non Renewable Resource" ;
                               rdfs:comment "Finite resource that does not replenish on a human timescale"@en ;
                               skos:example "Coal, crude oil, natural gas reserves"@en .


###  https://digicities.info/ontology#NonRenewableResourceAttribute
dici_onto:NonRenewableResourceAttribute rdf:type owl:Class ;
                                        rdfs:subClassOf dici_onto:ResourceAttribute ;
                                        rdfs:label "Non Renewable Resource Attribute"@en ;
                                        rdfs:comment "Typing marker grouping attributes that apply to a Non Renewable Resource; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#PhysicalAttribute
dici_onto:PhysicalAttribute rdf:type owl:Class ;
                            rdfs:subClassOf dici_onto:Attribute ;
                            rdfs:label "Physical Attribute" ;
                            rdfs:comment "Attribute holding a numeric physical quantity with a unit"@en ;
                            skos:example "Rated power (kW), rotor diameter (m), floor area (m2)"@en ;
                            skos:scopeNote "Use when the value is a number with a QUDT unit. Enumerated values are CategoricalAttribute; time-varying values are DynamicAttribute."@en ;
                            skos:definition "An attribute whose value is a single numeric quantity carrying a QUDT unit, e.g. a rated power in kilowatts or an area in square metres."@en .


###  https://digicities.info/ontology#PowerSensor
dici_onto:PowerSensor rdf:type owl:Class ;
                      rdfs:subClassOf dici_onto:Sensor ;
                      rdfs:label "Power Sensor" ;
                      dici_onto:hasDefaultUnit unit:KiloW ;
                      rdfs:comment "Sensor measuring instantaneous electrical or thermal power"@en .


###  https://digicities.info/ontology#PressureSensor
dici_onto:PressureSensor rdf:type owl:Class ;
                         rdfs:subClassOf dici_onto:Sensor ;
                         rdfs:label "Pressure Sensor" ;
                         dici_onto:hasDefaultUnit unit:PA ;
                         rdfs:comment "Sensor measuring pressure"@en .


###  https://digicities.info/ontology#Process
dici_onto:Process rdf:type owl:Class ;
                  rdfs:subClassOf dici_onto:Component ;
                  rdfs:comment "A process that transforms, transports, or modifies flows of energy or materials"@en ;
                  rdfs:label "Process" ;
                  dici_onto:definition "A process represents any activity or operation that has input and output flows, including energy conversion, material transformation, or transport operations"@en ;
                  skos:altLabel "Operation"@en ,
                                "Activity"@en ;
                  skos:example "Space heating, combustion in a boiler, charging a battery"@en ;
                  skos:scopeNote "A Process is the activity; the equipment performing it is a Component subclass (Converter, Storage, ...)."@en .


###  https://digicities.info/ontology#ProcessAttribute
dici_onto:ProcessAttribute rdf:type owl:Class ;
                           rdfs:subClassOf dici_onto:ComponentAttribute ;
                           rdfs:label "Process Attribute" ;
                           rdfs:comment "Typing marker grouping attributes that apply to a Process; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#ProcessCapacity
dici_onto:ProcessCapacity rdf:type owl:Class ;
                          rdfs:subClassOf dici_onto:ProcessAttribute ;
                          rdfs:comment "Maximum processing capacity"@en ;
                          rdfs:label "Process Capacity" ;
                          dici_onto:hasDefaultUnit unit:KiloW .


###  https://digicities.info/ontology#RenewableResource
dici_onto:RenewableResource rdf:type owl:Class ;
                            rdfs:subClassOf dici_onto:Resource ;
                            rdfs:label "Renewable Resource" ;
                            rdfs:comment "Resource that replenishes naturally on a human timescale"@en ;
                            skos:example "Wind, solar irradiation, hydro, geothermal heat"@en .


###  https://digicities.info/ontology#RenewableResourceAttribute
dici_onto:RenewableResourceAttribute rdf:type owl:Class ;
                                     rdfs:subClassOf dici_onto:ResourceAttribute ;
                                     rdfs:label "Renewable Resource Attribute"@en ;
                                     rdfs:comment "Typing marker grouping attributes that apply to a Renewable Resource; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#Resource
dici_onto:Resource rdf:type owl:Class ;
                   rdfs:subClassOf dici_onto:Component ;
                   rdfs:label "Resource" ;
                   rdfs:comment "Primary source of energy or material drawn from the environment"@en ;
                   skos:definition "A natural or primary resource that the system harvests, extracts or depends on, as distinct from the processed energy carriers derived from it."@en ;
                   skos:altLabel "Primary Resource"@en ,
                                 "Natural Resource"@en ;
                   skos:example "Wind, solar irradiation, groundwater, coal deposit"@en ;
                   skos:scopeNote "The wind blowing over a site is a Resource; the electricity generated from it is an ElectricityCarrier; the machine converting it is a Turbine."@en .


###  https://digicities.info/ontology#ResourceAttribute
dici_onto:ResourceAttribute rdf:type owl:Class ;
                            rdfs:subClassOf dici_onto:ComponentAttribute ;
                            rdfs:label "Resource Attribute"@en ;
                            rdfs:comment "Typing marker grouping attributes that apply to a Resource; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#SamplingRate
dici_onto:SamplingRate rdf:type owl:Class ;
                       rdfs:subClassOf dici_onto:SensorAttribute ;
                       rdfs:comment "Frequency of measurements or readings"@en ;
                       rdfs:label "Sampling Rate" ;
                       dici_onto:hasDefaultUnit unit:HZ .


###  https://digicities.info/ontology#Scenario
dici_onto:Scenario rdf:type owl:Class ;
                   rdfs:label "Scenario"@en ;
                   rdfs:comment "A what-if container: a named snapshot of replica components with attribute overrides"@en ;
                   skos:altLabel "Case"@en ,
                                 "Variant"@en ,
                                 "Simulation Case"@en ;
                   skos:scopeNote "Scenarios are thin: they reference the replica's components and carry only superseding attributes marked with usedInScenario."@en ;
                   skos:definition "A named what-if case built from a digital replica: it references the replica components involved and carries only the attribute values that differ from the replica baseline."@en ;
                   skos:example "A baseline scenario; a heat-pump-retrofit scenario derived from it with modified heating attributes"@en .


###  https://digicities.info/ontology#Sensor
dici_onto:Sensor rdf:type owl:Class ;
                 rdfs:subClassOf dici_onto:Device ;
                 rdfs:comment "Device that measures physical quantities and converts them to signals"@en ;
                 rdfs:label "Sensor" ;
                 dici_onto:definition "Sensors detect and respond to inputs from the physical environment, providing data for monitoring and control"@en ;
                 skos:altLabel "Detector"@en ,
                               "Probe"@en ,
                               "Measuring Device"@en ;
                 skos:example "Temperature sensor, pressure sensor, anemometer, pyranometer"@en .


###  https://digicities.info/ontology#SensorAttribute
dici_onto:SensorAttribute rdf:type owl:Class ;
                          rdfs:subClassOf dici_onto:DeviceAttribute ;
                          rdfs:label "Sensor Attribute" ;
                          rdfs:comment "Typing marker grouping attributes that apply to a Sensor; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#Service
dici_onto:Service rdf:type owl:Class ;
                  rdfs:label "Service"@en ;
                  rdfs:comment "An external model or tool (simulator, optimizer, forecaster) that consumes scenarios and returns results"@en ;
                  skos:altLabel "Model"@en ,
                                "External Service"@en ,
                                "Tool"@en ;
                  skos:example "Energy simulator, flexibility optimizer, wind power forecaster"@en ;
                  skos:definition "An external computational model reachable from the platform - a simulator, optimizer or forecaster - that consumes a converted scenario payload and returns results."@en .


###  https://digicities.info/ontology#ServiceRequirement
dici_onto:ServiceRequirement rdf:type owl:Class ;
                             rdfs:label "Service Requirement"@en ;
                             rdfs:comment "Declares an input a Service requires from a scenario: a component, an attribute, or a link between components"@en ;
                             skos:definition "A machine-readable statement of one input a Service needs from a scenario: a component of a given type, an attribute on it, or a link between two components."@en ;
                             skos:example "A wind power forecaster requiring a Location with a wind speed DynamicAttribute"@en .


