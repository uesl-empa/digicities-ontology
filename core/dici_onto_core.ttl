                  rdfs:label "Turbine" ;
                  rdfs:comment "Rotary energy converter extracting mechanical work from a moving fluid"@en ;
                  skos:altLabel "Wind Turbine"@en ,
                                "Gas Turbine"@en ,
                                "Steam Turbine"@en ,
                                "Hydro Turbine"@en ;
                  skos:example "A wind turbine in a wind park; a steam turbine in a CHP plant"@en ;
                  skos:scopeNote "A WindTurbine extension class belongs here (under Turbine), while the wind park it stands in is a Location and the wind it harvests is a Wind resource."@en .


