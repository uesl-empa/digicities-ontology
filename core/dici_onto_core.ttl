dici_onto:linksInputyEntityTo a owl:ObjectProperty ;
    rdfs:label "links input entity to (historical spelling)" ;
    rdfs:comment "Historical misspelling of linksInputEntityTo that the platform scenario tooling writes in ComponentLink data. Declared a subproperty of the canonical property so semantic queries via linksInputEntityTo still find the data under RDFS inference. Do not use in new vocabularies or code"@en ;
    rdfs:domain dici_onto:ComponentLink ;
    rdfs:range dici_onto:Component ;
    rdfs:subPropertyOf dici_onto:linksInputEntityTo ;
