dici_onto:maxValue a owl:DatatypeProperty ;
    rdfs:label "maximum value" ;
    rdfs:comment "Largest value in the Set: xsd:double for numeric sets, xsd:dateTime (latest) for temporal sets — hence no fixed range."@en .

dici_onto:mean a owl:DatatypeProperty ;
    rdfs:label "mean" ;
    rdfs:comment "Arithmetic mean of a numeric Set's values."@en ;
    rdfs:range xsd:double .

dici_onto:measures a owl:ObjectProperty ;
    rdfs:label "measures" ;
    rdfs:comment "Device measures a specific attribute"@en ;
    rdfs:domain dici_onto:Device ;
    rdfs:range dici_onto:Attribute .

dici_onto:median a owl:DatatypeProperty ;
    rdfs:label "median" ;
    rdfs:comment "Median of a numeric Set's values."@en ;
    rdfs:range xsd:double .

dici_onto:minValue a owl:DatatypeProperty ;
    rdfs:label "minimum value" ;
    rdfs:comment "Smallest value in the Set: xsd:double for numeric sets, xsd:dateTime (earliest) for temporal sets — hence no fixed range."@en .

dici_onto:mode a owl:DatatypeProperty ;
    rdfs:label "mode" ;
    rdfs:comment "Most frequent value in a categorical Set. Repeated when several values tie."@en .

dici_onto:modificationType a owl:DatatypeProperty ;
    rdfs:label "modification type" ;
    rdfs:comment "Kind of modification a derived scenario applies relative to its parent. Scenario-provenance metadata"@en ;
    rdfs:domain dici_onto:Scenario ;
    rdfs:range xsd:string .

dici_onto:modifiedComponents a owl:DatatypeProperty ;
    rdfs:label "modified components" ;
    rdfs:comment "Number of components modified in a derived scenario. Scenario-provenance metadata"@en ;
    rdfs:domain dici_onto:Scenario ;
    rdfs:range xsd:integer .

dici_onto:modifier a owl:DatatypeProperty ;
    rdfs:label "modifier"@en ;
    rdfs:comment "Kind of modification an assumption applies (e.g. multiply, replace)"@en ;
    rdfs:subPropertyOf dici_onto:assumptionDataProperty .

dici_onto:modifierValue a owl:DatatypeProperty ;
    rdfs:label "modifier value"@en ;
    rdfs:comment "The numeric value used by an assumption's modifier"@en ;
    rdfs:subPropertyOf dici_onto:assumptionDataProperty .

dici_onto:monitors a owl:ObjectProperty ;
    rdfs:label "monitors" ;
    rdfs:comment "Device monitors another component"@en ;
    rdfs:domain dici_onto:Device ;
    rdfs:range dici_onto:Component ;
    rdfs:subPropertyOf dici_onto:linksComponent .

dici_onto:numeratorUnit a owl:DatatypeProperty ;
    rdfs:label "numerator unit"@en ;
    rdfs:comment "Numerator unit of a custom physical ratio attribute"@en ;
    rdfs:subPropertyOf owl:topDataProperty .

dici_onto:occursDuring a owl:ObjectProperty ;
    rdfs:label "occurs during"@en ;
    rdfs:comment "Temporal association: one component or process occurs during another"@en ;
    rdfs:subPropertyOf dici_onto:linksComponent .

dici_onto:ofAttributeType a owl:ObjectProperty ;
    rdfs:label "of attribute type" ;
    rdfs:comment "The attribute class whose instances this collection aggregates (class-as-value, e.g. dici_onto:RotorDiameter)."@en ;
    rdfs:domain dici_onto:Collection .

dici_onto:operates a owl:ObjectProperty ;
    rdfs:label "operates" ;
    rdfs:comment "Operational control relationship"@en ;
    rdfs:domain dici_onto:Actor ;
    rdfs:range dici_onto:Component ;
    rdfs:subPropertyOf dici_onto:linksComponent .

dici_onto:owns a owl:ObjectProperty ;
    rdfs:label "owns" ;
    rdfs:comment "Ownership relationship between actors and components"@en ;
    rdfs:domain dici_onto:Actor ;
    rdfs:range dici_onto:Component ;
    rdfs:subPropertyOf dici_onto:linksComponent .

dici_onto:populationInfluenced a owl:DatatypeProperty ;
    rdfs:label "population influenced"@en ;
    rdfs:comment "Share or count of the population affected by an assumption"@en ;
    rdfs:subPropertyOf dici_onto:assumptionDataProperty .

dici_onto:realTimeSource a owl:ObjectProperty ;
    rdfs:label "real-time source" ;
    rdfs:comment "Reference to a real-time data source for live dynamic attributes"@en ;
    rdfs:domain dici_onto:DynamicAttribute .

dici_onto:sourceCatalog a owl:DatatypeProperty ;
    rdfs:label "source catalog" ;
    rdfs:comment "Catalog a service definition or template was sourced from. Registry-provenance metadata"@en ;
    rdfs:range xsd:string .

dici_onto:sourceType a owl:DatatypeProperty ;
    rdfs:label "source type" ;
    rdfs:comment "Kind of source a workspace artefact came from. Registry-provenance metadata"@en ;
    rdfs:range xsd:string .

dici_onto:sourceWorkspace a owl:DatatypeProperty ;
    rdfs:label "source workspace" ;
    rdfs:comment "Workspace an artefact was copied or imported from. Registry-provenance metadata"@en ;
    rdfs:range xsd:string .

dici_onto:standardDeviation a owl:DatatypeProperty ;
    rdfs:label "standard deviation" ;
    rdfs:comment "Sample standard deviation. Absent when the Set has fewer than two members."@en ;
    rdfs:range xsd:double .

dici_onto:startTime a owl:DatatypeProperty ;
    rdfs:label "start time" ;
    rdfs:comment "The starting timestamp of the time series data"@en ;
    rdfs:domain dici_onto:TimeSeries ;
    rdfs:range xsd:dateTime .

dici_onto:statisticUsed a owl:DatatypeProperty ;
    rdfs:label "statistic used" ;
    rdfs:comment "Which statistic of the underlying Set this aggregate attribute's value is (mean, median, sum, minValue, maxValue, count, standardDeviation)."@en ;
    rdfs:domain dici_onto:AggregateAttribute .

dici_onto:storedAt a owl:DatatypeProperty ;
    rdfs:label "stored at" ;
    rdfs:comment "The location or path where the time series data is stored"@en ;
    rdfs:domain dici_onto:TimeSeries ;
    rdfs:range xsd:string .

dici_onto:sum a owl:DatatypeProperty ;
    rdfs:label "sum" ;
    rdfs:comment "Sum of a numeric Set's values."@en ;
    rdfs:range xsd:double .

dici_onto:supersedesAttribute a owl:ObjectProperty ;
    rdfs:label "supersedes attribute"@en ;
    rdfs:comment "A thin-scenario override attribute points at the replica attribute it replaces. Consumers materialize a scenario by taking the replica and swapping in every attribute that supersedes one of its attributes"@en ;
    rdfs:domain dici_onto:Attribute ;
    rdfs:range dici_onto:Attribute ;
    skos:scopeNote "Written by the platform scenario tooling together with usedInScenario; the override carries the new value while the superseded replica attribute keeps the baseline value."@en .

dici_onto:targetAttribute a owl:ObjectProperty ;
    rdfs:label "target attribute"@en ;
    rdfs:comment "The attribute an Assumption modifies"@en ;
    rdfs:domain dici_onto:Assumption ;
    rdfs:range dici_onto:Attribute ;
    rdfs:subPropertyOf dici_onto:assumptionObjectProperty .

dici_onto:targetComponent a owl:ObjectProperty ;
    rdfs:label "target component"@en ;
    rdfs:comment "The component an Assumption applies to"@en ;
    rdfs:domain dici_onto:Assumption ;
    rdfs:range dici_onto:Component ;
    rdfs:subPropertyOf dici_onto:assumptionObjectProperty .

dici_onto:temporalResolution a owl:DatatypeProperty ;
    rdfs:label "temporal resolution" ;
    rdfs:comment "The time interval between data points in the time series (e.g., PT1H for hourly, PT15M for 15-minute intervals)"@en ;
    rdfs:domain dici_onto:TimeSeries ;
    rdfs:range xsd:duration .

dici_onto:timeSeriesType a owl:DatatypeProperty ;
    rdfs:label "time series type" ;
    rdfs:comment "The type of time series: 'Historic', 'Live', or 'Future'"@en ;
    rdfs:domain dici_onto:TimeSeries ;
    rdfs:range xsd:string .

dici_onto:usedInScenario a owl:ObjectProperty ;
    rdfs:label "used in scenario"@en ;
    rdfs:comment "Marks a component, attribute or link as belonging to a Scenario"@en ;
    rdfs:domain dici_onto:Attribute,
        dici_onto:Component,
        dici_onto:ComponentLink ;
    rdfs:range dici_onto:Scenario .

dici_onto:xUnitLabel a owl:DatatypeProperty ;
    rdfs:label "x unit label" ;
    rdfs:comment "String label for the x-axis unit of a CurveAttribute (e.g. 'DEG_C'). Emitted alongside dici_onto:xUnit IRI for backwards compatibility."@en ;
    rdfs:domain dici_onto:CurveAttribute ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dici_onto:hasUnitLabel .

dici_onto:yUnitLabel a owl:DatatypeProperty ;
    rdfs:label "y unit label" ;
    rdfs:comment "String label for the y-axis unit of a CurveAttribute (e.g. 'PERCENT'). Emitted alongside dici_onto:yUnit IRI for backwards compatibility."@en ;
    rdfs:domain dici_onto:CurveAttribute ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dici_onto:hasUnitLabel .

qudt:CurrencyUnit a owl:Class .

rdf:JSON a owl:Class .

xsd:duration a rdfs:Datatype .

skos:definition a owl:AnnotationProperty .

<https://digicities.info/ontology> a owl:Ontology ;
    rdfs:label "Digicities ontology"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source <https://digicities.info/ontology> ;
    rdfs:comment "Open OWL/RDF ontology for describing city-scale energy systems."@en ;
    owl:versionIRI <https://digicities.info/ontology/0.5.0> ;
    owl:versionInfo "0.6.0" .

dici_onto:ActorAttribute a owl:Class ;
    rdfs:label "Actor Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Actor; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:ActuatorPosition a owl:Class ;
    rdfs:label "Actuator Position" ;
    rdfs:comment "Current position or state of an actuator"@en ;
    rdfs:subClassOf dici_onto:ActuatorAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit unit:PERCENT .

dici_onto:AnnotationAttribute a owl:Class ;
    rdfs:label "Annotation Attribute" ;
    rdfs:comment "Attribute carrying free-text notes or commentary about a component, with its content in hasAnnotationValue"@en ;
    rdfs:subClassOf dici_onto:Attribute ;
    skos:altLabel "Comment"@en,
        "Note"@en ;
    skos:example "Data-quality remark, operator note"@en .

dici_onto:AssumptionSeries a owl:Class ;
    rdfs:label "Assumption (series)"@en ;
    rdfs:comment "Assumption modifying a series of values over time"@en ;
    rdfs:subClassOf dici_onto:Assumption .

dici_onto:CategoricalAttribute a owl:Class ;
    rdfs:label "Categorical Attribute" ;
    rdfs:comment "Attribute whose value is one of an enumerated set of categories"@en ;
    rdfs:subClassOf dici_onto:Attribute ;
    skos:definition "An attribute whose value is drawn from a closed set of named categories; the allowed values are declared as subclasses of the attribute class."@en ;
    skos:example "Insulation class (Poor / Average / Good), tariff type (Flat / Variable / Dual)"@en ;
    skos:scopeNote "Declare the allowed values as subclasses of the concrete attribute class."@en .

dici_onto:CircuitBreaker a owl:Class ;
    rdfs:label "Circuit Breaker" ;
    rdfs:comment "Switch that automatically interrupts electrical flow for safety"@en ;
    rdfs:subClassOf dici_onto:Switch .

dici_onto:CircuitBreakerAttribute a owl:Class ;
    rdfs:label "Circuit Breaker Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Circuit Breaker; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:SwitchAttribute .

dici_onto:ColdCarrier a owl:Class ;
    rdfs:label "Cold Carrier" ;
    rdfs:comment "Thermal energy carrier delivering cooling"@en ;
    rdfs:subClassOf dici_onto:ThermalEnergyCarrier ;
    skos:example "Chilled water, brine"@en .

dici_onto:ColdCarrierAttribute a owl:Class ;
    rdfs:label "Cold Carrier Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Cold Carrier; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ThermalEnergyCarrierAttribute .

dici_onto:CompositeWeatherObservation a owl:Class ;
    rdfs:label "Composite Weather Observation" ;
    rdfs:comment "Weather observation bundling several weather variables into one artefact, typically a weather file"@en ;
    rdfs:subClassOf dici_onto:WeatherObservation ;
    skos:altLabel "Composite Weather Data"@en,
        "EPW File"@en,
        "TMY Dataset"@en,
        "Weather File"@en ;
    skos:definition "A weather observation whose value is a multi-variable artefact (temperature, irradiance, wind, humidity and more in one dataset) rather than a single observed quantity. The artefact is usually an external weather file referenced from an attribute via hasDataPath."@en ;
    skos:example "An EPW weather file for Zurich backing a building simulation; a TMY3 dataset for a site"@en ;
    skos:scopeNote "Reference the file from an attribute via hasDataPath. A single observed weather variable (one temperature series) belongs on a WeatherObservation as an ordinary attribute instead."@en .

dici_onto:CompositeWeatherObservationAttribute a owl:Class ;
    rdfs:label "Composite Weather Observation Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Composite Weather Observation; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:WeatherObservationAttribute .

dici_onto:ConfigurationAttribute a owl:Class ;
    rdfs:label "Configuration Attribute"@en ;
    rdfs:comment "Attribute whose value exists for a model or service to operate (a boundary condition of the model run), not as an observation or behaviour of a component."@en ;
    rdfs:subClassOf dici_onto:Attribute ;
    skos:altLabel "Boundary condition"@en,
        "Config parameter"@en,
        "Configuration parameter"@en,
        "Model setting"@en,
        "Run parameter"@en ;
    skos:definition "A configuration parameter of a model or service: a value that sets a boundary condition of the model run, such as a model or algorithm choice, a calibration constant, a run name, a run frequency or a stream address. Orthogonal to the value kind: an attribute class is a ConfigurationAttribute AND its value kind (e.g. CategoricalAttribute, PhysicalAttribute). Its instances hang off a ServiceConfiguration via hasConfigurationParameter, never off a component."@en ;
    skos:example "Wake model type (Bastankhah_PorteAgel_2014), wake decay constant k, turbulence intensity used by the model, simulation name, input/output stream address, run frequency"@en ;
    skos:scopeNote "The test is whether the value is a boundary condition of the model run. A property you could observe or measure on the component itself (a turbine's hub height, a room's floor area) is NOT configuration, even when only one model uses it."@en .

dici_onto:Damper a owl:Class ;
    rdfs:label "Damper" ;
    rdfs:comment "Actuator that controls air flow"@en ;
    rdfs:subClassOf dici_onto:Actuator .

dici_onto:DamperAttribute a owl:Class ;
    rdfs:label "Damper Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Damper; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ActuatorAttribute .

dici_onto:DescriptiveStatistics a owl:Class ;
    rdfs:label "Descriptive Statistics" ;
    rdfs:comment "Aggregate statistics computed over the members of a Set. Which properties are populated depends on the datatype family of the Set's attribute type (numeric, categorical, temporal, boolean); inapplicable properties are absent, never null."@en .

dici_onto:DistributionBin a owl:Class ;
    rdfs:label "Distribution Bin" ;
    rdfs:comment "One bin of a Distribution: a label, optional numeric bounds, and a frequency."@en .

dici_onto:Efficiency a owl:Class ;
    rdfs:label "Efficiency" ;
    rdfs:comment "Conversion efficiency of a process"@en ;
    rdfs:subClassOf dici_onto:ConversionProcessAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit unit:PERCENT .

dici_onto:ElectricityCarrier a owl:Class ;
    rdfs:label "Electricity Carrier" ;
    rdfs:comment "Energy carrier for electrical energy"@en ;
    rdfs:subClassOf dici_onto:EnergyCarrier ;
    skos:example "Grid electricity, self-generated PV electricity"@en .

dici_onto:ElectricityCarrierAttribute a owl:Class ;
    rdfs:label "Electricity Carrier Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Electricity Carrier; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:EnergyCarrierAttribute .

dici_onto:ElectricityFlow a owl:Class ;
    rdfs:label "Electricity Flow" ;
    rdfs:comment "Flow of electrical energy between components"@en ;
    rdfs:subClassOf dici_onto:EnergyCarrierFlow ;
    dici_onto:hasDefaultUnit unit:KiloW .

dici_onto:ElectricityFlowAttribute a owl:Class ;
    rdfs:label "Electricity Flow Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to an Electricity Flow; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:EnergyCarrierFlowAttribute .

dici_onto:ElectricityMeter a owl:Class ;
    rdfs:label "Electricity Meter" ;
    rdfs:comment "Meter recording cumulative electrical energy consumption or production"@en ;
    rdfs:subClassOf dici_onto:Meter ;
    dici_onto:hasDefaultUnit unit:KiloW-HR .

dici_onto:ElectricityMeterAttribute a owl:Class ;
    rdfs:label "Electricity Meter Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to an Electricity Meter; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:MeterAttribute .

dici_onto:EnergyConsumer a owl:Class ;
    rdfs:label "Energy Consumer" ;
    rdfs:comment "Component whose primary role is to consume energy"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:altLabel "Demand"@en,
        "Energy Sink"@en,
        "Load"@en ;
    skos:definition "A component that takes energy out of the system for an end use. Consumers are the demand side: they receive flows but do not transform them into another carrier."@en ;
    skos:example "A building heating load, an EV charging station, an industrial process line"@en ;
    skos:scopeNote "Use for demand-side entities. A component that transforms energy onward rather than consuming it is a Converter."@en .

dici_onto:EnergyConsumerAttribute a owl:Class ;
    rdfs:label "Energy Consumer Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Energy Consumer; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:EnergyGenerator a owl:Class ;
    rdfs:label "Energy Generator" ;
    rdfs:comment "Component whose primary role is to produce energy"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:altLabel "Energy Source"@en,
        "Generator"@en,
        "Power Plant"@en,
        "Producer"@en ;
    skos:definition "A component that injects energy into the system. Generators are the supply side: the equipment that produces an energy carrier from a resource or fuel."@en ;
    skos:example "PV plant, diesel genset, CHP unit"@en ;
    skos:scopeNote "The generating equipment is an EnergyGenerator (or a Converter subclass such as Turbine); the site it stands on (e.g. a wind park as a place) is a Location."@en .

dici_onto:EnergyGeneratorAttribute a owl:Class ;
    rdfs:label "EnergyGenerator Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Energy Generator; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:EventAttribute a owl:Class ;
    rdfs:label "Event Attribute" ;
    rdfs:comment "Attribute describing discrete events in time"@en ;
    rdfs:subClassOf dici_onto:Attribute ;
    skos:example "Outage event, maintenance window"@en .

dici_onto:FlowCapacity a owl:Class ;
    rdfs:label "Flow Capacity" ;
    rdfs:comment "Maximum flow rate capacity"@en ;
    rdfs:subClassOf dici_onto:FlowAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit unit:KiloW .

dici_onto:FlowRate a owl:Class ;
    rdfs:label "Flow Rate" ;
    rdfs:comment "Rate of flow over time"@en ;
    rdfs:subClassOf dici_onto:FlowAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit unit:KiloW .

dici_onto:FlowSensor a owl:Class ;
    rdfs:label "Flow Sensor" ;
    rdfs:comment "Sensor measuring volumetric or mass flow rate"@en ;
    rdfs:subClassOf dici_onto:Sensor ;
    dici_onto:hasDefaultUnit unit:M3-PER-SEC .

dici_onto:FlowSensorAttribute a owl:Class ;
    rdfs:label "Flow Sensor Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Flow Sensor; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:SensorAttribute .

dici_onto:FutureTimeSeries a owl:Class ;
    rdfs:label "Future Time Series" ;
    rdfs:comment "Time series data representing forecasted or projected future values"@en ;
    rdfs:subClassOf dici_onto:TimeSeries ;
    skos:altLabel "Forecast"@en,
        "Prediction"@en,
        "Projection"@en ;
    skos:scopeNote "A wind, weather or demand forecast attaches to a DynamicAttribute via hasFutureTimeSeries."@en .

dici_onto:GasFlow a owl:Class ;
    rdfs:label "Gas Flow" ;
    rdfs:comment "Flow of gaseous fuel between components"@en ;
    rdfs:subClassOf dici_onto:EnergyCarrierFlow ;
    dici_onto:hasDefaultUnit unit:M3-PER-SEC .

dici_onto:GasFlowAttribute a owl:Class ;
    rdfs:label "Gas Flow Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Gas Flow; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:EnergyCarrierFlowAttribute .

dici_onto:GasMeter a owl:Class ;
    rdfs:label "Gas Meter" ;
    rdfs:comment "Meter recording cumulative gas volume consumed"@en ;
    rdfs:subClassOf dici_onto:Meter ;
    dici_onto:hasDefaultUnit unit:M3 .

dici_onto:GasMeterAttribute a owl:Class ;
    rdfs:label "Gas Meter Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Gas Meter; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:MeterAttribute .

dici_onto:GaseousFuelCarrier a owl:Class ;
    rdfs:label "Gaseous Fuel Carrier" ;
    rdfs:comment "Fuel carrier in gaseous form"@en ;
    rdfs:subClassOf dici_onto:FuelCarrier ;
    skos:example "Natural gas, biogas, hydrogen"@en .

dici_onto:GaseousFuelCarrierAttribute a owl:Class ;
    rdfs:label "Gaseous Fuel Carrier Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Gaseous Fuel Carrier; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:FuelCarrierAttribute .

dici_onto:HeatCarrier a owl:Class ;
    rdfs:label "Heat Carrier" ;
    rdfs:comment "Thermal energy carrier delivering heat"@en ;
    rdfs:subClassOf dici_onto:ThermalEnergyCarrier ;
    skos:example "District heating water, steam"@en .

dici_onto:HeatCarrierAttribute a owl:Class ;
    rdfs:label "Heat Carrier Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Heat Carrier; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ThermalEnergyCarrierAttribute .

dici_onto:HeatFlow a owl:Class ;
    rdfs:label "Heat Flow" ;
    rdfs:comment "Flow of thermal energy between components"@en ;
    rdfs:subClassOf dici_onto:EnergyCarrierFlow ;
    dici_onto:hasDefaultUnit unit:KiloW .

dici_onto:HeatFlowAttribute a owl:Class ;
    rdfs:label "Heat Flow Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Heat Flow; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:EnergyCarrierFlowAttribute .

dici_onto:HeatMeter a owl:Class ;
    rdfs:label "Heat Meter" ;
    rdfs:comment "Meter recording cumulative thermal energy delivered"@en ;
    rdfs:subClassOf dici_onto:Meter ;
    dici_onto:hasDefaultUnit unit:KiloW-HR .

dici_onto:HeatMeterAttribute a owl:Class ;
    rdfs:label "Heat Meter Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Heat Meter; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:MeterAttribute .

dici_onto:HistoricTimeSeries a owl:Class ;
    rdfs:label "Historic Time Series" ;
    rdfs:comment "Time series data representing past measurements or observations"@en ;
    rdfs:subClassOf dici_onto:TimeSeries ;
    skos:altLabel "Historical Data"@en,
        "Measured Data"@en .

dici_onto:InformationFlow a owl:Class ;
    rdfs:label "Information Flow" ;
    rdfs:comment "Flow of information or control signals between components"@en ;
    rdfs:subClassOf dici_onto:Flow ;
    skos:example "Sensor readings sent to a controller; a control signal sent to an actuator"@en .

dici_onto:InformationFlowAttribute a owl:Class ;
    rdfs:label "Information Flow Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Information Flow; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:FlowAttribute .

dici_onto:Junction a owl:Class ;
    rdfs:label "Junction" ;
    rdfs:comment "Component where multiple flows meet or diverge"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:altLabel "Bus"@en,
        "Connection Point"@en,
        "Node"@en ;
    skos:example "Electrical busbar, pipe tee, district-heating manifold"@en ;
    dici_onto:definition "Junctions represent nodes where flows can be split, merged, or redirected without transformation"@en .

dici_onto:JunctionAttribute a owl:Class ;
    rdfs:label "Junction Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Junction; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:LiquidFuel a owl:Class ;
    rdfs:label "Liquid Fuel Carrier" ;
    rdfs:comment "Fuel carrier in liquid form"@en ;
    rdfs:subClassOf dici_onto:FuelCarrier ;
    skos:example "Heating oil, diesel, biofuel"@en .

dici_onto:LiquidFuelFlow a owl:Class ;
    rdfs:label "Liquid Fuel Flow" ;
    rdfs:comment "Flow of liquid fuel between components"@en ;
    rdfs:subClassOf dici_onto:EnergyCarrierFlow ;
    dici_onto:hasDefaultUnit unit:L-PER-SEC .

dici_onto:LiquidFuelFlowAttribute a owl:Class ;
    rdfs:label "Liquid Fuel Flow Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Liquid Fuel Flow; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:EnergyCarrierFlowAttribute .

dici_onto:LiveTimeSeries a owl:Class ;
    rdfs:label "Live Time Series" ;
    rdfs:comment "Time series data representing real-time or near real-time measurements"@en ;
    rdfs:subClassOf dici_onto:TimeSeries ;
    skos:altLabel "Live Feed"@en,
        "Real-time Data"@en .

dici_onto:LocationAttribute a owl:Class ;
    rdfs:label "Location Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Location; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:Material a owl:Class ;
    rdfs:label "Material" ;
    rdfs:comment "Physical substance handled by the system that is not primarily an energy carrier"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:definition "A physical substance moved, stored or processed by the system - water, waste, feedstock - as opposed to an EnergyCarrier, whose role is to carry energy."@en ;
    skos:example "Water, waste, construction material, industrial feedstock"@en .

dici_onto:MaterialAttribute a owl:Class ;
    rdfs:label "Material Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Material; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:MaterialConverter a owl:Class ;
    rdfs:label "Material Converter" ;
    rdfs:comment "Converter transforming material inputs into different material outputs"@en ;
    rdfs:subClassOf dici_onto:Converter ;
    skos:example "Waste incinerator, biogas digester, recycling plant"@en .

dici_onto:MaterialConverterAttribute a owl:Class ;
    rdfs:label "Material Converter Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Material Converter; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ConverterAttribute .

dici_onto:MaterialFlow a owl:Class ;
    rdfs:label "Material Flow" ;
    rdfs:comment "Flow of materials between components"@en ;
    rdfs:subClassOf dici_onto:Flow ;
    skos:example "Waste stream, water supply, feedstock delivery"@en .

dici_onto:MaterialFlowAttribute a owl:Class ;
    rdfs:label "Material Flow Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Material Flow; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:FlowAttribute .

dici_onto:MaterialStorage a owl:Class ;
    rdfs:label "Material Storage" ;
    rdfs:comment "Storage holding materials"@en ;
    rdfs:subClassOf dici_onto:Storage ;
    skos:example "Water reservoir, silo, warehouse, fuel depot"@en .

dici_onto:MaterialStorageAttribute a owl:Class ;
    rdfs:label "Material Storage Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Material Storage; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:StorageAttribute .

dici_onto:MeasurementAccuracy a owl:Class ;
    rdfs:label "Measurement Accuracy" ;
    rdfs:comment "Accuracy specification of a measuring device"@en ;
    rdfs:subClassOf dici_onto:DeviceAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit unit:PERCENT .

dici_onto:MeasurementValue a owl:Class ;
    rdfs:label "Measurement Value" ;
    rdfs:comment "Current measured value from a sensor"@en ;
    rdfs:subClassOf dici_onto:DynamicAttribute,
        dici_onto:SensorAttribute .

dici_onto:MeterReading a owl:Class ;
    rdfs:label "Meter Reading" ;
    rdfs:comment "Cumulative measurement from a meter"@en ;
    rdfs:subClassOf dici_onto:DynamicAttribute,
        dici_onto:MeterAttribute .

dici_onto:Network a owl:Class ;
    rdfs:label "Network" ;
    rdfs:comment "Infrastructure for transporting energy carriers or materials"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:altLabel "Distribution Network"@en,
        "Grid"@en,
        "Infrastructure Network"@en ;
    skos:example "Electricity distribution grid, gas pipeline network, district heating network"@en ;
    skos:scopeNote "Network is the connective infrastructure through which flows move; the moving quantity itself is a Flow, and spatial grouping is a Location."@en ;
    dici_onto:definition "Networks represent the physical infrastructure that enables flows between components, such as electrical grids, gas pipelines, or district heating networks"@en .

dici_onto:NetworkAttribute a owl:Class ;
    rdfs:label "Network Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Network; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:NonRenewableResource a owl:Class ;
    rdfs:label "Non Renewable Resource" ;
    rdfs:comment "Finite resource that does not replenish on a human timescale"@en ;
    rdfs:subClassOf dici_onto:Resource ;
    skos:example "Coal, crude oil, natural gas reserves"@en .

dici_onto:NonRenewableResourceAttribute a owl:Class ;
    rdfs:label "Non Renewable Resource Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Non Renewable Resource; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ResourceAttribute .

dici_onto:PowerSensor a owl:Class ;
    rdfs:label "Power Sensor" ;
    rdfs:comment "Sensor measuring instantaneous electrical or thermal power"@en ;
    rdfs:subClassOf dici_onto:Sensor ;
    dici_onto:hasDefaultUnit unit:KiloW .

dici_onto:PowerSensorAttribute a owl:Class ;
    rdfs:label "Power Sensor Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Power Sensor; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:SensorAttribute .

dici_onto:PressureSensor a owl:Class ;
    rdfs:label "Pressure Sensor" ;
    rdfs:comment "Sensor measuring pressure"@en ;
    rdfs:subClassOf dici_onto:Sensor ;
    dici_onto:hasDefaultUnit unit:PA .

dici_onto:PressureSensorAttribute a owl:Class ;
    rdfs:label "Pressure Sensor Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Pressure Sensor; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:SensorAttribute .

dici_onto:ProcessCapacity a owl:Class ;
    rdfs:label "Process Capacity" ;
    rdfs:comment "Maximum processing capacity"@en ;
    rdfs:subClassOf dici_onto:PhysicalAttribute,
        dici_onto:ProcessAttribute ;
    dici_onto:hasDefaultUnit unit:KiloW .

dici_onto:Reference a owl:Class ;
    rdfs:label "Reference" ;
    rdfs:comment "A citable information source (report, paper, dataset, website) that replica or scenario data points to as provenance. Instances are created from the Reference sheet of the ingestion template"@en ;
    skos:altLabel "Citation"@en,
        "Source"@en ;
    skos:example "A journal article identified by DOI backing an efficiency value"@en .

dici_onto:SamplingRate a owl:Class ;
    rdfs:label "Sampling Rate" ;
    rdfs:comment "Frequency of measurements or readings"@en ;
    rdfs:subClassOf dici_onto:PhysicalAttribute,
        dici_onto:SensorAttribute ;
    dici_onto:hasDefaultUnit unit:HZ .

dici_onto:SetPoint a owl:Class ;
    rdfs:label "Set Point" ;
    rdfs:comment "Target value for a controller"@en ;
    rdfs:subClassOf dici_onto:ControllerAttribute,
        dici_onto:SimpleValueAttribute .

dici_onto:SimpleValueAttribute a owl:Class ;
    rdfs:label "Simple Value Attribute" ;
    rdfs:comment "Attribute holding a plain literal value without unit semantics"@en ;
    rdfs:subClassOf dici_onto:Attribute .

dici_onto:SolarResource a owl:Class ;
    rdfs:label "Solar Resource" ;
    rdfs:comment "Solar irradiation as a harvestable renewable energy resource"@en ;
    rdfs:subClassOf dici_onto:RenewableResource ;
    skos:altLabel "Insolation"@en,
        "Solar Irradiation"@en .

dici_onto:SolarResourceAttribute a owl:Class ;
    rdfs:label "Solar Resource Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Solar Resource; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:RenewableResourceAttribute .

dici_onto:SolidFuel a owl:Class ;
    rdfs:label "Solid Fuel Carrier" ;
    rdfs:comment "Fuel carrier in solid form"@en ;
    rdfs:subClassOf dici_onto:FuelCarrier ;
    skos:example "Wood chips, pellets, coal"@en .

dici_onto:StateOfCharge a owl:Class ;
    rdfs:label "State of Charge" ;
    rdfs:comment "Current state of charge as percentage of capacity"@en ;
    rdfs:subClassOf dici_onto:EnergyStorageAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit unit:PERCENT .

dici_onto:StorageCapacity a owl:Class ;
    rdfs:label "Storage Capacity" ;
    rdfs:comment "Maximum storage capacity"@en ;
    rdfs:subClassOf dici_onto:PhysicalAttribute,
        dici_onto:StorageAttribute ;
    dici_onto:hasDefaultUnit unit:KiloW-HR .

dici_onto:StorageProcess a owl:Class ;
    rdfs:label "Storage Process" ;
    rdfs:comment "Process that stores and releases energy or materials over time"@en ;
    rdfs:subClassOf dici_onto:Process ;
    skos:example "Charging and discharging a battery; filling a thermal store"@en .

dici_onto:StorageProcessAttribute a owl:Class ;
    rdfs:label "Storage Process Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Storage Process; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ProcessAttribute .

dici_onto:SwitchState a owl:Class ;
    rdfs:label "Switch State" ;
    rdfs:comment "Current state of a switch (open/closed, on/off)"@en ;
    rdfs:subClassOf dici_onto:CategoricalAttribute,
        dici_onto:SwitchAttribute .

dici_onto:TemperatureSensor a owl:Class ;
    rdfs:label "Temperature Sensor" ;
    rdfs:comment "Sensor measuring temperature"@en ;
    rdfs:subClassOf dici_onto:Sensor ;
    dici_onto:hasDefaultUnit unit:DEG_C .

dici_onto:TemperatureSensorAttribute a owl:Class ;
    rdfs:label "Temperature Sensor Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Temperature Sensor; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:SensorAttribute .

dici_onto:TransportProcess a owl:Class ;
    rdfs:label "Transport Process" ;
    rdfs:comment "Process that transports energy or materials without transformation"@en ;
    rdfs:subClassOf dici_onto:Process ;
    skos:example "Pumping water through a pipe; transmitting electricity over a line"@en .

dici_onto:TransportProcessAttribute a owl:Class ;
    rdfs:label "Transport Process Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Transport Process; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ProcessAttribute .

dici_onto:Turbine a owl:Class ;
    rdfs:label "Turbine" ;
    rdfs:comment "Rotary energy converter extracting mechanical work from a moving fluid"@en ;
    rdfs:subClassOf dici_onto:EnergyConverter ;
    skos:altLabel "Gas Turbine"@en,
        "Hydro Turbine"@en,
        "Steam Turbine"@en,
        "Wind Turbine"@en ;
    skos:example "A wind turbine in a wind park; a steam turbine in a CHP plant"@en ;
    skos:scopeNote "A WindTurbine extension class belongs here (under Turbine), while the wind park it stands in is a Location and the wind it harvests is a Wind resource."@en .

dici_onto:TurbineAttribute a owl:Class ;
    rdfs:label "Turbine Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Turbine; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:EnergyConverterAttribute .

dici_onto:Valve a owl:Class ;
    rdfs:label "Valve" ;
    rdfs:comment "Actuator that controls fluid flow"@en ;
    rdfs:subClassOf dici_onto:Actuator .

dici_onto:ValveAttribute a owl:Class ;
    rdfs:label "Valve Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Valve; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ActuatorAttribute .

dici_onto:Wind a owl:Class ;
    rdfs:label "Wind Resource" ;
    rdfs:comment "The wind as a harvestable renewable energy resource"@en ;
    rdfs:subClassOf dici_onto:RenewableResource ;
    skos:altLabel "Wind Energy"@en,
        "Wind Potential"@en ;
    skos:example "The wind resource at a wind park site, characterised by speed and direction profiles"@en ;
    skos:scopeNote "Use for the wind resource itself. A wind park (the site) maps to Location; a wind turbine (the machine) maps to Turbine; forecast wind speeds are DynamicAttributes with a FutureTimeSeries."@en .

dici_onto:aggregatedIn a owl:ObjectProperty ;
    rdfs:label "aggregated in" ;
    rdfs:comment "Links an attribute instance to a Set it is a member of. The materializer asserts only this direction; query the other with ^aggregatedIn."@en ;
    rdfs:domain dici_onto:Attribute ;
    rdfs:range dici_onto:Set .

dici_onto:carriesResource a owl:ObjectProperty ;
    rdfs:label "carries resource" ;
    rdfs:comment "The resource (energy carrier or material) being transported by the flow"@en ;
    rdfs:domain dici_onto:Flow ;
    rdfs:range dici_onto:Resource .

dici_onto:controls a owl:ObjectProperty ;
    rdfs:label "controls" ;
    rdfs:comment "Device controls another component"@en ;
    rdfs:domain dici_onto:Device ;
    rdfs:range dici_onto:Component ;
    rdfs:subPropertyOf dici_onto:linksComponent .

dici_onto:feeds a owl:ObjectProperty ;
    rdfs:label "feeds"@en ;
    rdfs:comment "Supply relationship: this component feeds another component"@en ;
    rdfs:subPropertyOf dici_onto:linksComponent .

dici_onto:hasConfiguration a owl:ObjectProperty ;
    rdfs:label "has configuration"@en ;
    rdfs:comment "A Service owns a ServiceConfiguration profile."@en ;
    rdfs:domain dici_onto:Service ;
    rdfs:range dici_onto:ServiceConfiguration .

dici_onto:hasControllerAttribute a owl:ObjectProperty ;
    rdfs:label "has controller attribute" ;
    rdfs:comment "Attaches a Controller attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:Controller ;
    rdfs:range dici_onto:ControllerAttribute ;
    rdfs:subPropertyOf dici_onto:hasDeviceAttribute .

dici_onto:hasConversionProcessAttribute a owl:ObjectProperty ;
    rdfs:label "has conversion process attribute" ;
    rdfs:comment "Attaches a Conversion Process attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:ConversionProcess ;
    rdfs:range dici_onto:ConversionProcessAttribute ;
    rdfs:subPropertyOf dici_onto:hasProcessAttribute .

dici_onto:hasEnergyConverterAttribute a owl:ObjectProperty ;
    rdfs:label "has energy converter attribute"@en ;
    rdfs:comment "Attaches a Energy Converter attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:EnergyConverter ;
    rdfs:range dici_onto:EnergyConverterAttribute ;
    rdfs:subPropertyOf dici_onto:hasConverterAttribute .

dici_onto:hasEnergyStorageAttribute a owl:ObjectProperty ;
    rdfs:label "has energy storage attribute" ;
    rdfs:comment "Attaches a Energy Storage attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:EnergyStorage ;
    rdfs:range dici_onto:EnergyStorageAttribute ;
    rdfs:subPropertyOf dici_onto:hasStorageAttribute .

dici_onto:hasObservationAttribute a owl:ObjectProperty ;
    rdfs:label "has observation attribute"@en ;
    rdfs:comment "Attaches an Observation attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:Observation ;
    rdfs:range dici_onto:ObservationAttribute ;
    rdfs:subPropertyOf dici_onto:hasComponentAttribute .

dici_onto:hasSet a owl:ObjectProperty ;
    rdfs:label "has set" ;
    rdfs:comment "Links a data source (a Reference) to a Collection derived from it. Only asserted when a Collection was restricted to one data source."@en ;
    rdfs:range dici_onto:Collection .

dici_onto:hasWeatherObservationAttribute a owl:ObjectProperty ;
    rdfs:label "has weather observation attribute"@en ;
    rdfs:comment "Attaches a Weather Observation attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:WeatherObservation ;
    rdfs:range dici_onto:WeatherObservationAttribute ;
    rdfs:subPropertyOf dici_onto:hasObservationAttribute .

dici_onto:isAttributeOf a owl:ObjectProperty ;
    rdfs:label "is attribute of" ;
    rdfs:comment "An attribute is required by a ServiceRequirement (inverse of hasInputAttribute)"@en ;
    rdfs:domain dici_onto:Attribute ;
    rdfs:range dici_onto:ServiceRequirement .

dici_onto:isDestinationOf a owl:ObjectProperty ;
    rdfs:label "is destination of" ;
    rdfs:comment "The component receives a flow (inverse of hasDestination)"@en ;
    rdfs:domain dici_onto:Component ;
    rdfs:range dici_onto:Flow ;
    rdfs:subPropertyOf dici_onto:linksComponent .

dici_onto:isEntityOf a owl:ObjectProperty ;
    rdfs:label "is entity of" ;
    rdfs:comment "A component is the subject entity of a ServiceRequirement"@en ;
    rdfs:domain dici_onto:Component ;
    rdfs:range dici_onto:ServiceRequirement .

dici_onto:isFutureTimeSeriesOf a owl:ObjectProperty ;
    rdfs:label "is future time series of"@en ;
    rdfs:comment "A forecast time series describes a dynamic attribute"@en ;
    rdfs:domain dici_onto:FutureTimeSeries ;
    rdfs:range dici_onto:DynamicAttribute ;
    rdfs:subPropertyOf dici_onto:isTimeSeriesOf .

dici_onto:isHistoricTimeSeriesOf a owl:ObjectProperty ;
    rdfs:label "is historic time series of"@en ;
    rdfs:comment "A historical time series describes a dynamic attribute"@en ;
    rdfs:domain dici_onto:HistoricTimeSeries ;
    rdfs:range dici_onto:DynamicAttribute ;
    rdfs:subPropertyOf dici_onto:isTimeSeriesOf .

dici_onto:isLiveTimeSeriesOf a owl:ObjectProperty ;
    rdfs:label "is live time series of"@en ;
    rdfs:comment "A live time series describes a dynamic attribute"@en ;
    rdfs:domain dici_onto:LiveTimeSeries ;
    rdfs:range dici_onto:DynamicAttribute ;
    rdfs:subPropertyOf dici_onto:isTimeSeriesOf .

dici_onto:isSourceOf a owl:ObjectProperty ;
    rdfs:label "is source of" ;
    rdfs:comment "The component originates a flow (inverse of hasSource)"@en ;
    rdfs:domain dici_onto:Component ;
    rdfs:range dici_onto:Flow ;
    rdfs:subPropertyOf dici_onto:linksComponent .

dici_onto:linksInputEntityTo a owl:ObjectProperty ;
    rdfs:label "links input entity to"@en ;
    rdfs:comment "A ComponentLink points at its target component"@en ;
    rdfs:domain dici_onto:ComponentLink ;
    rdfs:range dici_onto:Component .

dici_onto:partOf a owl:ObjectProperty ;
    rdfs:label "part of"@en ;
    rdfs:comment "Whole-part composition: this component is part of another component"@en ;
    rdfs:subPropertyOf dici_onto:linksComponent .

dici_onto:requires a owl:ObjectProperty ;
    rdfs:label "requires" ;
    rdfs:comment "A Service requires a ServiceRequirement to be satisfied by the submitted scenario"@en ;
    rdfs:domain dici_onto:Service ;
    rdfs:range dici_onto:ServiceRequirement .

dici_onto:xAttribute a owl:ObjectProperty ;
    rdfs:label "x attribute" ;
    rdfs:comment "Quantity kind of the x axis of a curve attribute"@en ;
    rdfs:domain dici_onto:CurveAttribute ;
    rdfs:range qudt:QuantityKind .

dici_onto:xUnit a owl:ObjectProperty ;
    rdfs:label "x unit" ;
    rdfs:comment "Unit of the x axis of a curve attribute"@en ;
    rdfs:domain dici_onto:CurveAttribute ;
    rdfs:range qudt:Unit ;
    rdfs:subPropertyOf dici_onto:hasUnit .

dici_onto:yAttribute a owl:ObjectProperty ;
    rdfs:label "y attribute" ;
    rdfs:comment "Quantity kind of the y axis of a curve attribute"@en ;
    rdfs:domain dici_onto:CurveAttribute ;
    rdfs:range qudt:QuantityKind .

dici_onto:yUnit a owl:ObjectProperty ;
    rdfs:label "y unit" ;
    rdfs:comment "Unit of the y axis of a curve attribute"@en ;
    rdfs:domain dici_onto:CurveAttribute ;
    rdfs:range qudt:Unit ;
    rdfs:subPropertyOf dici_onto:hasUnit .

skos:altLabel a owl:AnnotationProperty .

dici_onto:AggregateAttribute a owl:Class ;
    rdfs:label "Aggregate Attribute" ;
    rdfs:comment "A DERIVED attribute node projecting one statistic of a component-grouped Set onto the group's component instance (e.g. FloorAreaMean on a District), in the exact shape authored attributes take (hasAttribute edge, has<Component><Name>Attribute predicate, qudt:value + qudt:unit) — so services request it as Component.attribute with no special handling. Written by the collections materializer into the collections graph; never authored."@en ;
    rdfs:subClassOf dici_onto:Attribute .

dici_onto:Controller a owl:Class ;
    rdfs:label "Controller" ;
    rdfs:comment "Device that manages and coordinates other devices or processes"@en ;
    rdfs:subClassOf dici_onto:Device ;
    skos:altLabel "BMS"@en,
        "Building Management System"@en,
        "Control Unit"@en ;
    skos:example "Thermostat, building management system, SCADA controller"@en ;
    dici_onto:definition "Controllers implement control logic and coordinate the operation of other system components"@en .

dici_onto:ControllerAttribute a owl:Class ;
    rdfs:label "Controller Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Controller; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:DeviceAttribute .

dici_onto:ConversionProcess a owl:Class ;
    rdfs:label "Conversion Process" ;
    rdfs:comment "Process that converts one form of energy to another"@en ;
    rdfs:subClassOf dici_onto:Process ;
    skos:example "Gas to heat in a boiler; electricity to heat in a heat pump"@en .

dici_onto:ConversionProcessAttribute a owl:Class ;
    rdfs:label "Conversion Process Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Conversion Process; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ProcessAttribute .

dici_onto:Distribution a owl:Class ;
    rdfs:label "Distribution" ;
    rdfs:comment "Binned/frequency representation of the values in a Set: histogram bins for numeric values, category frequencies for categorical values."@en .

dici_onto:EnergyConverter a owl:Class ;
    rdfs:label "Energy Converter" ;
    rdfs:comment "Converter transforming energy between carriers or forms"@en ;
    rdfs:subClassOf dici_onto:Converter ;
    skos:example "Heat pump, boiler, fuel cell, inverter, wind turbine generator"@en .

dici_onto:EnergyConverterAttribute a owl:Class ;
    rdfs:label "Energy Converter Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Energy Converter; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ConverterAttribute .

dici_onto:EnergyStorage a owl:Class ;
    rdfs:label "Energy Storage" ;
    rdfs:comment "Storage holding energy for later use"@en ;
    rdfs:subClassOf dici_onto:Storage ;
    skos:example "Battery, thermal storage tank, hydrogen storage"@en .

dici_onto:EnergyStorageAttribute a owl:Class ;
    rdfs:label "Energy Storage Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Energy Storage; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:StorageAttribute .

dici_onto:GroupedSet a owl:Class ;
    rdfs:label "Grouped Set" ;
    rdfs:comment "A partition of an attribute type over the distinct values of a grouping attribute type on the same components (SQL GROUP BY analogue). Members are Sets, one per group key."@en ;
    rdfs:subClassOf dici_onto:Collection .

dici_onto:LiquidFuelAttribute a owl:Class ;
    rdfs:label "Liquid Fuel Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Liquid Fuel; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:FuelCarrierAttribute .

dici_onto:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:comment "Observed phenomenon or measurement record that stands on its own, without a modelled sensor or piece of equipment behind it"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:altLabel "Field Observation"@en,
        "Measurement Record"@en,
        "Observed Data"@en,
        "Recording"@en ;
    skos:definition "An Observation is a component that carries observed or recorded data about a phenomenon when the observing equipment is not part of the model. The observed values attach to it as ordinary attributes, so data can enter the replica without inventing a device to own it."@en ;
    skos:example "A weather record for a site; an observed traffic count on a road; an air-quality reading for a district"@en ;
    skos:scopeNote "Use when only the observed data matters. If the observing device IS part of the model, attach the data to that device (Sensor, Meter) instead; a single measured property of an existing component stays an Attribute on that component, not an Observation."@en .

dici_onto:ObservationAttribute a owl:Class ;
    rdfs:label "Observation Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to an Observation; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:ReferenceType a owl:Class ;
    rdfs:label "Reference Type" ;
    rdfs:comment "Kind of citable source a Reference is; the allowed values are its named individuals"@en ;
    skos:example "DOI"@en .

dici_onto:SolidFuelAttribute a owl:Class ;
    rdfs:label "Solid Fuel Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Solid Fuel; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:FuelCarrierAttribute .

dici_onto:WeatherObservation a owl:Class ;
    rdfs:label "Weather Observation" ;
    rdfs:comment "Observation of weather conditions at a place, independent of any weather-station equipment"@en ;
    rdfs:subClassOf dici_onto:Observation ;
    skos:altLabel "Meteorological Observation"@en,
        "Weather Data"@en,
        "Weather Record"@en ;
    skos:definition "An observation carrying observed or recorded weather data (temperature, wind, irradiance, precipitation and similar) for a place, used when no weather station or sensor is modelled."@en ;
    skos:example "Observed hourly temperature and wind speed for a site in 2024"@en ;
    skos:scopeNote "For a modelled weather station or sensor (the device), use Sensor. For the harvestable resource itself, use SolarResource or Wind. A bundle of many weather variables in one artefact (a weather file) is a CompositeWeatherObservation."@en .

dici_onto:WeatherObservationAttribute a owl:Class ;
    rdfs:label "Weather Observation Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Weather Observation; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ObservationAttribute .

dici_onto:WindAttribute a owl:Class ;
    rdfs:label "Wind Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Wind; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:RenewableResourceAttribute .

dici_onto:assumptionObjectProperty a owl:ObjectProperty ;
    rdfs:label "assumption object property"@en ;
    rdfs:comment "Root property for links from an Assumption to its targets"@en .

dici_onto:hasAttribute a owl:ObjectProperty ;
    rdfs:label "has Attribute" ;
    rdfs:comment "Attaches an Attribute node to a Component; root of the has-attribute property hierarchy"@en ;
    rdfs:domain dici_onto:Component ;
    rdfs:range dici_onto:Attribute .

dici_onto:hasColdCarrierAttribute a owl:ObjectProperty ;
    rdfs:label "has cold carrier attribute" ;
    rdfs:comment "Attaches a Cold Carrier attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:ColdCarrier ;
    rdfs:range dici_onto:ColdCarrierAttribute ;
    rdfs:subPropertyOf dici_onto:hasThermalEnergyCarrierAttribute .

dici_onto:hasConverterAttribute a owl:ObjectProperty ;
    rdfs:label "has converter attribute"@en ;
    rdfs:comment "Attaches a Converter attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:Converter ;
    rdfs:range dici_onto:ConverterAttribute ;
    rdfs:subPropertyOf dici_onto:hasComponentAttribute .

dici_onto:hasElectricityCarrierAttribute a owl:ObjectProperty ;
    rdfs:label "has electricity carrier attribute"@en ;
    rdfs:comment "Attaches an Electricity Carrier attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:ElectricityCarrier ;
    rdfs:range dici_onto:ElectricityCarrierAttribute ;
    rdfs:subPropertyOf dici_onto:hasEnergyCarrierAttribute .

dici_onto:hasGaseousFuelCarrierAttribute a owl:ObjectProperty ;
    rdfs:label "has gaseous fuel carrier attribute"@en ;
    rdfs:comment "Attaches a Gaseous Fuel Carrier attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:GaseousFuelCarrier ;
    rdfs:range dici_onto:GaseousFuelCarrierAttribute ;
    rdfs:subPropertyOf dici_onto:hasFuelCarrierAttribute .

dici_onto:hasHeatCarrierAttribute a owl:ObjectProperty ;
    rdfs:label "has heat carrier attribute" ;
    rdfs:comment "Attaches a Heat Carrier attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:HeatCarrier ;
    rdfs:range dici_onto:HeatCarrierAttribute ;
    rdfs:subPropertyOf dici_onto:hasThermalEnergyCarrierAttribute .

dici_onto:hasNonRenewableResourceAttribute a owl:ObjectProperty ;
    rdfs:label "has non renewable resource attribute" ;
    rdfs:comment "Attaches a Non Renewable Resource attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:NonRenewableResource ;
    rdfs:range dici_onto:NonRenewableResourceAttribute ;
    rdfs:subPropertyOf dici_onto:hasResourceAttribute .

dici_onto:hasResourceAttribute a owl:ObjectProperty ;
    rdfs:label "has resource attribute"@en ;
    rdfs:comment "Attaches a Resource attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:Resource ;
    rdfs:range dici_onto:ResourceAttribute ;
    rdfs:subPropertyOf dici_onto:hasComponentAttribute .

dici_onto:hasSolarResourceAttribute a owl:ObjectProperty ;
    rdfs:label "has solar resource attribute"@en ;
    rdfs:comment "Attaches a Solar Resource attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:SolarResource ;
    rdfs:range dici_onto:SolarResourceAttribute ;
    rdfs:subPropertyOf dici_onto:hasRenewableResourceAttribute .

dici_onto:hasSwitchAttribute a owl:ObjectProperty ;
    rdfs:label "has switch attribute" ;
    rdfs:comment "Attaches a Switch attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:Switch ;
    rdfs:range dici_onto:SwitchAttribute ;
    rdfs:subPropertyOf dici_onto:hasDeviceAttribute .

dici_onto:hasUnitLabel a owl:DatatypeProperty ;
    rdfs:label "has unit label" ;
    rdfs:comment "A human-readable string label for the unit of an attribute instance (e.g. 'KWh', 'KWh/yr', 'm2'). Used alongside qudt:unit (ObjectProperty) to provide a string representation that applications can consume directly. For CustomPhysicalRatioAttribute instances this is the primary unit expression; for Physical, UnitBasedCost, Curve, Geospatial and TimeSeries attributes it is emitted in addition to the qudt:unit IRI for backwards compatibility."@en ;
    rdfs:domain dici_onto:Attribute ;
    rdfs:range xsd:string .

dici_onto:locationOf a owl:ObjectProperty ;
    rdfs:label "location of"@en ;
    rdfs:comment "A Location hosts a component (inverse of the location attachment properties)"@en ;
    rdfs:subPropertyOf dici_onto:linksComponent .

unit:KiloW-HR a owl:NamedIndividual .

dici_onto:Actor a owl:Class ;
    rdfs:label "Actor" ;
    rdfs:comment "Human or organizational agent that owns, operates, or regulates components"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:altLabel "Operator"@en,
        "Organisation"@en,
        "Owner"@en,
        "Stakeholder"@en ;
    skos:example "A utility company, a grid operator, a municipality, a household, a regulator"@en ;
    skos:scopeNote "Use for humans and organisations that own, operate or regulate components. Automatic acting equipment is a Device (Actuator, Controller), not an Actor."@en ;
    dici_onto:definition "Actors represent stakeholders in the energy system including operators, regulators, consumers, and policy makers"@en .

dici_onto:Converter a owl:Class ;
    rdfs:label "Converter" ;
    rdfs:comment "Component that transforms an input into a different output form (energy or material)"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:altLabel "Conversion Unit"@en,
        "Transformer"@en ;
    skos:definition "A machine or installation that converts energy from one form or carrier to another, or transforms materials. The equipment is the Converter; the transformation activity it performs is a ConversionProcess."@en ;
    skos:example "Heat pump, boiler, electrolyser, turbine, inverter"@en .

dici_onto:ConverterAttribute a owl:Class ;
    rdfs:label "Converter Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Converter; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:RenewableResource a owl:Class ;
    rdfs:label "Renewable Resource" ;
    rdfs:comment "Resource that replenishes naturally on a human timescale"@en ;
    rdfs:subClassOf dici_onto:Resource ;
    skos:example "Wind, solar irradiation, hydro, geothermal heat"@en .

dici_onto:RenewableResourceAttribute a owl:Class ;
    rdfs:label "Renewable Resource Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Renewable Resource; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ResourceAttribute .

dici_onto:ResourceAttribute a owl:Class ;
    rdfs:label "Resource Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Resource; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:Switch a owl:Class ;
    rdfs:label "Switch" ;
    rdfs:comment "Device that can interrupt or divert the flow of energy or materials"@en ;
    rdfs:subClassOf dici_onto:Device ;
    skos:example "Relay, circuit breaker, transfer switch"@en ;
    dici_onto:definition "Switches control the routing or interruption of flows in the system"@en .

dici_onto:SwitchAttribute a owl:Class ;
    rdfs:label "Switch Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Switch; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:DeviceAttribute .

dici_onto:ThermalEnergyCarrier a owl:Class ;
    rdfs:label "Thermal Energy Carrier" ;
    rdfs:comment "Energy carrier transporting thermal energy (heat or cold)"@en ;
    rdfs:subClassOf dici_onto:EnergyCarrier .

dici_onto:ThermalEnergyCarrierAttribute a owl:Class ;
    rdfs:label "Thermal Energy Carrier Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Thermal Energy Carrier; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:EnergyCarrierAttribute .

dici_onto:hasActuatorAttribute a owl:ObjectProperty ;
    rdfs:label "has actuator attribute" ;
    rdfs:comment "Attaches a Actuator attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:Actuator ;
    rdfs:range dici_onto:ActuatorAttribute ;
    rdfs:subPropertyOf dici_onto:hasDeviceAttribute .

dici_onto:hasEnergyCarrierAttribute a owl:ObjectProperty ;
    rdfs:label "has energy carrier attribute"@en ;
    rdfs:comment "Attaches a Energy Carrier attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:EnergyCarrier ;
    rdfs:range dici_onto:EnergyCarrierAttribute ;
    rdfs:subPropertyOf dici_onto:hasComponentAttribute .

dici_onto:hasStorageAttribute a owl:ObjectProperty ;
    rdfs:label "has storage attribute" ;
    rdfs:comment "Attaches a Storage attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:Storage ;
    rdfs:range dici_onto:StorageAttribute ;
    rdfs:subPropertyOf dici_onto:hasComponentAttribute .

dici_onto:hasTimeSeries a owl:ObjectProperty ;
    rdfs:label "has time series" ;
    rdfs:comment "Links a dynamic attribute to its associated time series data"@en ;
    rdfs:domain dici_onto:DynamicAttribute ;
    rdfs:range dici_onto:TimeSeries ;
    owl:inverseOf dici_onto:isTimeSeriesOf .

dici_onto:hasTimeSeriesReference a owl:DatatypeProperty ;
    rdfs:label "has time series reference"@en ;
    rdfs:comment "Root property referencing external time series data from an attribute"@en .

dici_onto:timeSeriesReferenceOf a owl:DatatypeProperty ;
    rdfs:label "time series reference of"@en ;
    rdfs:comment "Root inverse-direction property for time series references"@en .

dici_onto:ActuatorAttribute a owl:Class ;
    rdfs:label "Actuator Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Actuator; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:DeviceAttribute .

dici_onto:Assumption a owl:Class ;
    rdfs:label "Assumption"@en ;
    rdfs:comment "A modification rule applied to attributes when deriving a scenario"@en ;
    skos:altLabel "Modifier"@en,
        "What-if Change"@en .

dici_onto:EnergyCarrierAttribute a owl:Class ;
    rdfs:label "Energy Carrier Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Energy Carrier; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:FuelCarrier a owl:Class ;
    rdfs:label "Fuel Carrier" ;
    rdfs:comment "Combustible energy carrier"@en ;
    rdfs:subClassOf dici_onto:EnergyCarrier ;
    skos:altLabel "Fuel"@en ;
    skos:example "Natural gas, heating oil, wood pellets, hydrogen"@en .

dici_onto:FuelCarrierAttribute a owl:Class ;
    rdfs:label "Fuel Carrier Attribute"@en ;
    rdfs:comment "Typing marker grouping attributes that apply to a Fuel Carrier; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:EnergyCarrierAttribute .

dici_onto:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "Spatial entity representing geographic areas or specific sites"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:altLabel "Area"@en,
        "District"@en,
        "Place"@en,
        "Region"@en,
        "Site"@en,
        "Zone"@en ;
    skos:example "A wind park, a city district, a campus, a building plot, a municipality"@en ;
    skos:scopeNote "Use as the parent for spatial grouping concepts: a WindPark or a Campus is a Location. Do not use Network (connectivity infrastructure) or Junction (flow nodes) for spatial grouping. Components attach to a Location via dici_onto:locatedAt."@en ;
    dici_onto:definition "Locations provide spatial context for components and flows, enabling geographic analysis and constraints"@en .

dici_onto:Resource a owl:Class ;
    rdfs:label "Resource" ;
    rdfs:comment "Primary source of energy or material drawn from the environment"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:altLabel "Natural Resource"@en,
        "Primary Resource"@en ;
    skos:definition "A natural or primary resource that the system harvests, extracts or depends on, as distinct from the processed energy carriers derived from it."@en ;
    skos:example "Wind, solar irradiation, groundwater, coal deposit"@en ;
    skos:scopeNote "The wind blowing over a site is a Resource; the electricity generated from it is an ElectricityCarrier; the machine converting it is a Turbine."@en .

dici_onto:Service a owl:Class ;
    rdfs:label "Service"@en ;
    rdfs:comment "An external model or tool (simulator, optimizer, forecaster) that consumes scenarios and returns results"@en ;
    skos:altLabel "External Service"@en,
        "Model"@en,
        "Tool"@en ;
    skos:definition "An external computational model reachable from the platform - a simulator, optimizer or forecaster - that consumes a converted scenario payload and returns results."@en ;
    skos:example "Energy simulator, flexibility optimizer, wind power forecaster"@en .

dici_onto:ServiceConfiguration a owl:Class ;
    rdfs:label "Service Configuration"@en ;
    rdfs:comment "A configuration profile of one Service: the set of configuration parameters for one way of running it (typically one config file or run setup)."@en ;
    skos:altLabel "Configuration profile"@en,
        "Model configuration"@en,
        "Run configuration"@en ;
    skos:definition "A named configuration profile owned by one Service, grouping the ConfigurationAttribute values one run setup uses. NOT a Component: it describes how a model runs, not a thing in the system. It may name the components it is tuned for (appliesTo); a profile with no appliesTo configures the service as a whole."@en ;
    skos:example "simulation_alkmaar (wake model, k, TI) applying to WindPark Alkmaar; a runtime profile holding a forecaster's input and output stream addresses"@en .

dici_onto:Storage a owl:Class ;
    rdfs:label "Storage" ;
    rdfs:comment "Component that stores energy or materials over time"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:altLabel "Buffer"@en,
        "Reservoir"@en,
        "Store"@en ;
    skos:example "Battery, hot water tank, pumped hydro reservoir, hydrogen store"@en ;
    dici_onto:definition "Storage components accumulate and release energy or materials, providing temporal flexibility to the system"@en .

dici_onto:StorageAttribute a owl:Class ;
    rdfs:label "Storage Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Storage; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:assumptionDataProperty a owl:DatatypeProperty ;
    rdfs:label "assumption data property"@en ;
    rdfs:comment "Root data property for values carried by an Assumption"@en .

dici_onto:hasEnergyCarrierFlowAttribute a owl:ObjectProperty ;
    rdfs:label "has energy carrier flow attribute" ;
    rdfs:comment "Attaches a Energy Carrier Flow attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:EnergyCarrierFlow ;
    rdfs:range dici_onto:EnergyCarrierFlowAttribute ;
    rdfs:subPropertyOf dici_onto:hasFlowAttribute .

dici_onto:hasMeterAttribute a owl:ObjectProperty ;
    rdfs:label "has meter attribute" ;
    rdfs:comment "Attaches a Meter attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:Meter ;
    rdfs:range dici_onto:MeterAttribute ;
    rdfs:subPropertyOf dici_onto:hasDeviceAttribute .

dici_onto:hasProcessAttribute a owl:ObjectProperty ;
    rdfs:label "has process attribute" ;
    rdfs:comment "Attaches a Process attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:Process ;
    rdfs:range dici_onto:ProcessAttribute ;
    rdfs:subPropertyOf dici_onto:hasComponentAttribute .

dici_onto:hasRenewableResourceAttribute a owl:ObjectProperty ;
    rdfs:label "has renewable resource attribute" ;
    rdfs:comment "Attaches a Renewable Resource attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:RenewableResource ;
    rdfs:range dici_onto:RenewableResourceAttribute ;
    rdfs:subPropertyOf dici_onto:hasResourceAttribute .

dici_onto:hasThermalEnergyCarrierAttribute a owl:ObjectProperty ;
    rdfs:label "has thermal energy carrier attribute" ;
    rdfs:comment "Attaches a Thermal Energy Carrier attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:ThermalEnergyCarrier ;
    rdfs:range dici_onto:ThermalEnergyCarrierAttribute ;
    rdfs:subPropertyOf dici_onto:hasEnergyCarrierAttribute .

dici_onto:hasUnit a owl:ObjectProperty ;
    rdfs:label "has unit" ;
    rdfs:comment "Links an attribute to its QUDT unit"@en ;
    rdfs:domain dici_onto:Attribute ;
    rdfs:range qudt:Unit .

dici_onto:isTimeSeriesOf a owl:ObjectProperty ;
    rdfs:label "is time series of" ;
    rdfs:comment "Links a time series to the dynamic attribute it represents"@en ;
    rdfs:domain dici_onto:TimeSeries ;
    rdfs:range dici_onto:DynamicAttribute .

qudt:QuantityKind a owl:Class .

dici_onto:Actuator a owl:Class ;
    rdfs:label "Actuator" ;
    rdfs:comment "Device that converts control signals into physical action"@en ;
    rdfs:subClassOf dici_onto:Device ;
    skos:example "Valve actuator, damper motor, relay"@en ;
    dici_onto:definition "Actuators are devices that produce motion or control mechanisms based on input signals"@en .

dici_onto:Collection a owl:Class ;
    rdfs:label "Collection" ;
    rdfs:comment "Abstract grouping of attribute instances derived from a dataset. Superclass of Set and GroupedSet. Collections are derived, recomputable artefacts — not authored data."@en .

dici_onto:ComponentLink a owl:Class ;
    rdfs:label "Component Link"@en ;
    rdfs:comment "Reified edge connecting two components in a scenario, via hasInputEntity and linksInputEntityTo"@en .

dici_onto:EnergyCarrier a owl:Class ;
    rdfs:label "Energy Carrier" ;
    rdfs:comment "The medium or commodity form in which energy is stored, transported and consumed"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:altLabel "Energy Commodity"@en,
        "Energy Vector"@en ;
    skos:definition "An energy vector: the commodity that carries energy through the system, independent of the infrastructure that moves it."@en ;
    skos:example "Electricity, district heat, natural gas, hydrogen, biomass"@en ;
    skos:scopeNote "EnergyCarrier is the commodity (what), Flow is its movement (the transfer), Network is the infrastructure it moves through."@en .

dici_onto:EnergyCarrierFlowAttribute a owl:Class ;
    rdfs:label "Energy Carrier Flow Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Energy Carrier Flow; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:FlowAttribute .

dici_onto:Meter a owl:Class ;
    rdfs:label "Meter" ;
    rdfs:comment "Device that measures and records consumption or production of resources"@en ;
    rdfs:subClassOf dici_onto:Device ;
    skos:altLabel "Metering Device"@en ;
    skos:example "Electricity meter, gas meter, heat meter"@en ;
    skos:scopeNote "Meters record cumulative consumption or production over time; instantaneous physical quantities are measured by Sensors."@en ;
    dici_onto:definition "Meters measure cumulative quantities like energy consumption, flow volumes, or resource usage over time"@en .

dici_onto:MeterAttribute a owl:Class ;
    rdfs:label "Meter Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Meter; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:DeviceAttribute .

dici_onto:Process a owl:Class ;
    rdfs:label "Process" ;
    rdfs:comment "A process that transforms, transports, or modifies flows of energy or materials"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:altLabel "Activity"@en,
        "Operation"@en ;
    skos:example "Space heating, combustion in a boiler, charging a battery"@en ;
    skos:scopeNote "A Process is the activity; the equipment performing it is a Component subclass (Converter, Storage, ...)."@en ;
    dici_onto:definition "A process represents any activity or operation that has input and output flows, including energy conversion, material transformation, or transport operations"@en .

dici_onto:ProcessAttribute a owl:Class ;
    rdfs:label "Process Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Process; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:hasFlowAttribute a owl:ObjectProperty ;
    rdfs:label "has flow attribute" ;
    rdfs:comment "Attaches a Flow attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:Flow ;
    rdfs:range dici_onto:FlowAttribute ;
    rdfs:subPropertyOf dici_onto:hasComponentAttribute .

dici_onto:hasFuelCarrierAttribute a owl:ObjectProperty ;
    rdfs:label "has fuel carrier attribute"@en ;
    rdfs:comment "Attaches a Fuel Carrier attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:FuelCarrier ;
    rdfs:range dici_onto:FuelCarrierAttribute ;
    rdfs:subPropertyOf dici_onto:hasEnergyCarrierAttribute .

dici_onto:EnergyCarrierFlow a owl:Class ;
    rdfs:label "Energy Carrier Flow" ;
    rdfs:comment "Flow of energy carriers between components"@en ;
    rdfs:subClassOf dici_onto:Flow ;
    skos:example "Electricity flow, heat flow, gas flow"@en .

dici_onto:FlowAttribute a owl:Class ;
    rdfs:label "Flow Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Flow; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:TemporalPrecision a owl:Class ;
    rdfs:label "Temporal Precision" ;
    rdfs:comment "Granularity of an event attribute temporal value; the allowed values are its named individuals"@en ;
    skos:example "Year, Year-Month, Date, Date-Time, Unknown"@en .

dici_onto:hasDeviceAttribute a owl:ObjectProperty ;
    rdfs:label "has device attribute" ;
    rdfs:comment "Attaches a Device attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:Device ;
    rdfs:range dici_onto:DeviceAttribute ;
    rdfs:subPropertyOf dici_onto:hasComponentAttribute .

dici_onto:hasSensorAttribute a owl:ObjectProperty ;
    rdfs:label "has sensor attribute" ;
    rdfs:comment "Attaches a Sensor attribute to its component; part of the has-attribute property hierarchy under dici_onto:hasAttribute"@en ;
    rdfs:domain dici_onto:Sensor ;
    rdfs:range dici_onto:SensorAttribute ;
    rdfs:subPropertyOf dici_onto:hasDeviceAttribute .

qudt:Unit a owl:Class .

dici_onto:CurveAttribute a owl:Class ;
    rdfs:label "Curve Attribute" ;
    rdfs:comment "Attribute represented by x-y coordinate pairs forming a curve"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dici_onto:xAttribute ;
            owl:someValuesFrom qudt:QuantityKind ],
        [ a owl:Restriction ;
            owl:onProperty dici_onto:xUnit ;
            owl:someValuesFrom qudt:Unit ],
        [ a owl:Restriction ;
            owl:onProperty dici_onto:yAttribute ;
            owl:someValuesFrom qudt:QuantityKind ],
        [ a owl:Restriction ;
            owl:onProperty dici_onto:yUnit ;
            owl:someValuesFrom qudt:Unit ],
        [ a owl:Restriction ;
            owl:onProperty dici_onto:hasAttributeValue ;
            owl:someValuesFrom rdfs:Literal ],
        dici_onto:Attribute ;
    skos:example "Heat pump COP as a function of outdoor temperature"@en ;
    dici_onto:definition "An attribute represented by a set of x,y coordinate pairs forming a curve"@en .

dici_onto:DeviceAttribute a owl:Class ;
    rdfs:label "Device Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Device; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:comment "Device that measures physical quantities and converts them to signals"@en ;
    rdfs:subClassOf dici_onto:Device ;
    skos:altLabel "Detector"@en,
        "Measuring Device"@en,
        "Probe"@en ;
    skos:example "Temperature sensor, pressure sensor, anemometer, pyranometer"@en ;
    dici_onto:definition "Sensors detect and respond to inputs from the physical environment, providing data for monitoring and control"@en .

dici_onto:SensorAttribute a owl:Class ;
    rdfs:label "Sensor Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Sensor; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:DeviceAttribute .

dici_onto:Set a owl:Class ;
    rdfs:label "Set" ;
    rdfs:comment "A collection of attribute instances of a single attribute type, drawn from one workspace replica (optionally restricted to one data source), or one partition of a GroupedSet. Carries descriptive statistics."@en ;
    rdfs:subClassOf dici_onto:Collection .

dici_onto:ServiceRequirement a owl:Class ;
    rdfs:label "Service Requirement"@en ;
    rdfs:comment "Declares an input a Service requires from a scenario: a component, an attribute, or a link between components"@en ;
    skos:definition "A machine-readable statement of one input a Service needs from a scenario: a component of a given type, an attribute on it, or a link between two components."@en ;
    skos:example "A wind power forecaster requiring a Location with a wind speed DynamicAttribute"@en .

dici_onto:hasAttributeValue a owl:DatatypeProperty ;
    rdfs:label "has attribute value" ;
    rdfs:comment "Root data property carrying the literal value of an attribute"@en ;
    rdfs:domain dici_onto:Attribute .

dici_onto:DynamicAttribute a owl:Class ;
    rdfs:label "Dynamic Attribute" ;
    rdfs:comment "Attribute whose value varies over time and is backed by time series data"@en ;
    rdfs:subClassOf dici_onto:Attribute ;
    skos:definition "An attribute whose value is a function of time rather than a single number; its data lives in linked TimeSeries nodes or external time series references."@en ;
    skos:example "Electricity demand profile, wind speed series, outdoor temperature"@en ;
    skos:scopeNote "Link the data via hasTimeSeries or the time-series reference properties; forecasts use FutureTimeSeries, measurements HistoricTimeSeries."@en .

dici_onto:PhysicalAttribute a owl:Class ;
    rdfs:label "Physical Attribute" ;
    rdfs:comment "Attribute holding a numeric physical quantity with a unit"@en ;
    rdfs:subClassOf dici_onto:Attribute ;
    skos:definition "An attribute whose value is a single numeric quantity carrying a QUDT unit, e.g. a rated power in kilowatts or an area in square metres."@en ;
    skos:example "Rated power (kW), rotor diameter (m), floor area (m2)"@en ;
    skos:scopeNote "Use when the value is a number with a QUDT unit. Enumerated values are CategoricalAttribute; time-varying values are DynamicAttribute."@en .

dici_onto:Device a owl:Class ;
    rdfs:label "Device" ;
    rdfs:comment "Physical or virtual devices that monitor, control, or measure components in the energy system"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:altLabel "Equipment"@en,
        "Instrument"@en ;
    skos:example "Sensors, meters, controllers, switches, actuators"@en ;
    skos:scopeNote "Use for monitoring, control and measurement equipment. Machinery that converts or stores energy belongs under Converter or Storage, not Device."@en ;
    dici_onto:definition "Devices are components that provide sensing, actuation, measurement, or control capabilities within the energy system"@en .

dici_onto:TimeSeries a owl:Class ;
    rdfs:label "Time Series" ;
    rdfs:comment "A sequence of data points indexed in time order, typically used to represent dynamic attributes over time"@en ;
    skos:altLabel "Data Series"@en,
        "Profile"@en,
        "Timeseries"@en ;
    skos:example "Hourly electricity demand for 2024; a 48-hour wind speed forecast"@en ;
    dici_onto:definition "A time series is a series of data points indexed (or listed or graphed) in time order. Time series data is used to track changes over time for dynamic attributes."@en .

dici_onto:Scenario a owl:Class ;
    rdfs:label "Scenario"@en ;
    rdfs:comment "A what-if container: a named snapshot of replica components with attribute overrides"@en ;
    skos:altLabel "Case"@en,
        "Simulation Case"@en,
        "Variant"@en ;
    skos:definition "A named what-if case built from a digital replica: it references the replica components involved and carries only the attribute values that differ from the replica baseline."@en ;
    skos:example "A baseline scenario; a heat-pump-retrofit scenario derived from it with modified heating attributes"@en ;
    skos:scopeNote "Scenarios are thin: they reference the replica's components and carry only superseding attributes marked with usedInScenario."@en .

dici_onto:Flow a owl:Class ;
    rdfs:label "Flow" ;
    rdfs:comment "Represents the movement or transfer of energy, materials, or information between components"@en ;
    rdfs:subClassOf dici_onto:Component ;
    skos:altLabel "Stream"@en,
        "Transfer"@en ;
    skos:example "Electricity flow from the grid to a building; heat flow from a plant into a district network"@en ;
    skos:scopeNote "A Flow connects a source Component to a destination Component (hasSource / hasDestination) and carries a Resource or EnergyCarrier (carriesResource). Use the typed subclasses (ElectricityFlow, HeatFlow, ...) where one fits."@en ;
    dici_onto:definition "A flow captures the dynamic transfer of entities (energy carriers, materials, etc.) between system components, including quantity, direction, and temporal characteristics"@en .

dici_onto:hasComponentAttribute a owl:ObjectProperty ;
    rdfs:label "has component attribute"@en ;
    rdfs:comment "Attaches a component attribute to a Component; parent of the per-component-type attachment properties"@en ;
    rdfs:domain dici_onto:Component ;
    rdfs:range dici_onto:ComponentAttribute ;
    rdfs:subPropertyOf dici_onto:hasAttribute .

dici_onto:ComponentAttribute a owl:Class ;
    rdfs:label "Component Attribute" ;
    rdfs:comment "Typing marker grouping attributes that apply to a Component; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en ;
    rdfs:subClassOf dici_onto:Attribute .

dici_onto:linksComponent a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "links component"@en ;
    rdfs:comment "Root symmetric property for any component-to-component relationship"@en ;
    rdfs:domain dici_onto:Component ;
    rdfs:range dici_onto:Component .

dici_onto:Attribute a owl:Class ;
    rdfs:label "Attribute" ;
    rdfs:comment "Root class for measurable or descriptive properties attached to Components"@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Characteristic"@en,
        "Field"@en,
        "Parameter"@en,
        "Property"@en,
        "Variable"@en ;
    skos:definition "An Attribute is a typed property-value node attached to a Component via dici_onto:hasAttribute (or a subproperty); the value itself is carried by qudt:value or another hasAttributeValue subproperty."@en ;
    skos:example "Rated power, floor area, insulation class, electricity demand profile"@en ;
    skos:scopeNote "Concrete attribute classes subclass BOTH a kind (PhysicalAttribute, CategoricalAttribute, DynamicAttribute, ...) AND the owning component's attribute-group class (e.g. TurbineAttribute)."@en .

dici_onto:Component a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:comment "Root class for every entity that can appear in a digital replica: infrastructure, places, actors, resources, flows and processes"@en ;
    skos:altLabel "Asset"@en,
        "Entity"@en,
        "System Element"@en ;
    skos:definition "The universal base class for things that exist in a modelled system. Every domain concept that represents an entity (rather than a measurable property) must be a direct or indirect subclass of Component."@en ;
    skos:example "Buildings, turbines, districts, pipes, energy carriers, grid operators"@en ;
    skos:scopeNote "Every new component type in an extension must be rdfs:subClassOf* Component or it will not appear in the platform UI. Measurable properties are NOT Components - subclass Attribute instead."@en .

