                                       "Live Feed"@en .


###  https://digicities.info/ontology#Location
dici_onto:Location rdf:type owl:Class ;
                   rdfs:subClassOf dici_onto:Component ;
                   rdfs:comment "Spatial entity representing geographic areas or specific sites"@en ;
                   rdfs:label "Location" ;
                   dici_onto:definition "Locations provide spatial context for components and flows, enabling geographic analysis and constraints"@en ;
                   skos:altLabel "Site"@en ,
                                 "Area"@en ,
                                 "Zone"@en ,
                                 "Place"@en ,
                                 "Region"@en ,
                                 "District"@en ;
                   skos:example "A wind park, a city district, a campus, a building plot, a municipality"@en ;
                   skos:scopeNote "Use as the parent for spatial grouping concepts: a WindPark or a Campus is a Location. Do not use Network (connectivity infrastructure) or Junction (flow nodes) for spatial grouping. Components attach to a Location via dici_onto:locatedAt."@en .


###  https://digicities.info/ontology#LocationAttribute
dici_onto:LocationAttribute rdf:type owl:Class ;
                            rdfs:subClassOf dici_onto:ComponentAttribute ;
                            rdfs:label "Location Attribute" ;
                            rdfs:comment "Typing marker grouping attributes that apply to a Location; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


###  https://digicities.info/ontology#Material
dici_onto:Material rdf:type owl:Class ;
                   rdfs:subClassOf dici_onto:Component ;
                   rdfs:label "Material" ;
                   rdfs:comment "Physical substance handled by the system that is not primarily an energy carrier"@en ;
                   skos:example "Water, waste, construction material, industrial feedstock"@en ;
                   skos:definition "A physical substance moved, stored or processed by the system - water, waste, feedstock - as opposed to an EnergyCarrier, whose role is to carry energy."@en .


###  https://digicities.info/ontology#MaterialAttribute
dici_onto:MaterialAttribute rdf:type owl:Class ;
                            rdfs:subClassOf dici_onto:ComponentAttribute ;
                            rdfs:label "Material Attribute" ;
                            rdfs:comment "Typing marker grouping attributes that apply to a Material; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


