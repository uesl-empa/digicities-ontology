#################################################################
#    Data properties
#################################################################

###  http://qudt.org/schema/qudt/numericValue
qudt:numericValue rdf:type owl:DatatypeProperty .


###  http://qudt.org/schema/qudt/value
qudt:value rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf dici_onto:hasAttributeValue ;
           rdfs:domain dici_onto:Attribute .


###  https://digicities.info/ontology#assumptionDataProperty
dici_onto:assumptionDataProperty rdf:type owl:DatatypeProperty ;
                                 rdfs:label "assumption data property"@en ;
                                 rdfs:comment "Root data property for values carried by an Assumption"@en .


###  https://digicities.info/ontology#assumptionTimesteps
dici_onto:assumptionTimesteps rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf dici_onto:assumptionDataProperty ;
                              rdfs:domain dici_onto:AssumptionSeries ;
                              rdfs:label "assumption timesteps"@en ;
                              rdfs:comment "The timesteps at which an assumption series applies"@en .


###  https://digicities.info/ontology#denominatorUnit
dici_onto:denominatorUnit rdf:type owl:DatatypeProperty ;
                          rdfs:label "denominator unit"@en ;
                          rdfs:comment "Denominator unit of a custom physical ratio attribute"@en .


