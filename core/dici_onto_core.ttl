dici_onto:MaterialStorageAttribute rdf:type owl:Class ;
                                   rdfs:subClassOf dici_onto:StorageAttribute ;
                                   rdfs:label "Material Storage Attribute" ;
                                   rdfs:comment "Typing marker grouping attributes that apply to a Material Storage; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


