                           rdfs:label "Measurement Value" .


###  https://digicities.info/ontology#Meter
dici_onto:Meter rdf:type owl:Class ;
                rdfs:subClassOf dici_onto:Device ;
                rdfs:comment "Device that measures and records consumption or production of resources"@en ;
                rdfs:label "Meter" ;
                dici_onto:definition "Meters measure cumulative quantities like energy consumption, flow volumes, or resource usage over time"@en ;
                skos:altLabel "Metering Device"@en ;
                skos:example "Electricity meter, gas meter, heat meter"@en ;
                skos:scopeNote "Meters record cumulative consumption or production over time; instantaneous physical quantities are measured by Sensors."@en .


###  https://digicities.info/ontology#MeterAttribute
dici_onto:MeterAttribute rdf:type owl:Class ;
                         rdfs:subClassOf dici_onto:DeviceAttribute ;
                         rdfs:label "Meter Attribute" ;
                         rdfs:comment "Typing marker grouping attributes that apply to a Meter; lets SPARQL select all attributes of one component type via rdfs:subClassOf*"@en .


